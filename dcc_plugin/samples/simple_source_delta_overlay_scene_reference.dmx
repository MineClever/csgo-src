<!-- dmx encoding keyvalues2 1 format model 1 -->
"DmElement"
{
    "id" "elementid" "source-delta-overlay-scene"
    "name" "string" "SourceDeltaOverlayScene"
    "skeleton" "DmeModel"
    {
        "id" "elementid" "source-delta-overlay-model"
        "name" "string" "source_delta_root"
        "children" "element_array"
        [
            "DmeJoint"
            {
                "id" "elementid" "source-delta-overlay-joint"
                "name" "string" "source_delta_joint"
                "transform" "DmeTransform"
                {
                    "id" "elementid" "source-delta-overlay-joint-transform"
                    "name" "string" "source_delta_joint"
                    "position" "vector3" "0 0 0"
                    "orientation" "quaternion" "0 0 0 1"
                    "scale" "vector3" "1 1 1"
                }
            }
        ]
        "transform" "DmeTransform"
        {
            "id" "elementid" "source-delta-overlay-model-transform"
            "position" "vector3" "0 0 0"
            "orientation" "quaternion" "0 0 0 1"
        }
    }
    "animationList" "DmeAnimationList"
    {
        "id" "elementid" "source-delta-overlay-animation-list"
        "name" "string" "source_delta_root"
        "animations" "element_array"
        [
            "DmeChannelsClip"
            {
                "id" "elementid" "source-delta-overlay-clip"
                "name" "string" "overlay_pose"
                "timeFrame" "DmeTimeFrame"
                {
                    "id" "elementid" "source-delta-overlay-timeframe"
                    "name" "string" "timeframe"
                    "duration" "time" "1.0000"
                    "scale" "float" "1.000000"
                }
                "frameRate" "int" "24"
                "channels" "element_array"
                [
                    "DmeChannel"
                    {
                        "id" "elementid" "source-delta-overlay-position-channel"
                        "name" "string" "source_delta_joint_position_overlay"
                        "toAttribute" "string" "position"
                        "toElement" "element" "source-delta-overlay-joint-transform"
                        "mode" "int" "1"
                        "log" "DmeVector3Log"
                        {
                            "id" "elementid" "source-delta-overlay-position-log"
                            "name" "string" "Vector3 log"
                            "layers" "element_array"
                            [
                                "DmeVector3LogLayer"
                                {
                                    "id" "elementid" "source-delta-overlay-position-layer"
                                    "name" "string" "Vector3 log"
                                    "times" "time_array"
                                    [
                                        "0.0000",
                                        "0.5000",
                                        "1.0000"
                                    ]
                                    "values" "vector3_array"
                                    [
                                        "1 0 0",
                                        "2 0 0",
                                        "4 0 0"
                                    ]
                                }
                            ]
                        }
                    },
                    "DmeChannel"
                    {
                        "id" "elementid" "source-delta-overlay-orientation-channel"
                        "name" "string" "source_delta_joint_orientation_overlay"
                        "toAttribute" "string" "orientation"
                        "toElement" "element" "source-delta-overlay-joint-transform"
                        "mode" "int" "1"
                        "log" "DmeQuaternionLog"
                        {
                            "id" "elementid" "source-delta-overlay-orientation-log"
                            "name" "string" "Quaternion log"
                            "layers" "element_array"
                            [
                                "DmeQuaternionLogLayer"
                                {
                                    "id" "elementid" "source-delta-overlay-orientation-layer"
                                    "name" "string" "Quaternion log"
                                    "times" "time_array"
                                    [
                                        "0.0000",
                                        "0.5000",
                                        "1.0000"
                                    ]
                                    "values" "quaternion_array"
                                    [
                                        "0 0 0.0871557 0.9961947",
                                        "0 0 0.2164396 0.9762960",
                                        "0 0 0.3420201 0.9396926"
                                    ]
                                }
