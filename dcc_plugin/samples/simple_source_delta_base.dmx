                        "toElement" "element" "source-delta-base-joint-transform"
                        "mode" "int" "1"
                        "log" "DmeVector3Log"
                        {
                            "id" "elementid" "source-delta-base-position-log"
                            "name" "string" "Vector3 log"
                            "layers" "element_array"
                            [
                                "DmeVector3LogLayer"
                                {
                                    "id" "elementid" "source-delta-base-position-layer"
                                    "name" "string" "Vector3 log"
                                    "times" "time_array"
                                    [
                                        "0.0000",
                                        "0.5000",
                                        "1.0000"
                                    ]
                                    "values" "vector3_array"
                                    [
                                        "0 0 0",
                                        "1 0 0",
                                        "2 0 0"
                                    ]
                                }
                            ]
                        }
                    },
                    "DmeChannel"
                    {
                        "id" "elementid" "source-delta-base-orientation-channel"
