<!-- dmx encoding keyvalues2 1 format model 1 -->
"DmElement"
{
    "id" "elementid" "source-delta-base-scene"
    "name" "string" "SourceDeltaBaseScene"
    "skeleton" "DmeModel"
    {
        "id" "elementid" "source-delta-base-model"
        "name" "string" "source_delta_root"
