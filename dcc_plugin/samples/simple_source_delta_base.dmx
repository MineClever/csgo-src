                        "toElement" "element" "source-delta-base-joint-transform"
                        "mode" "int" "1"
                        "log" "DmeQuaternionLog"
                        {
                            "id" "elementid" "source-delta-base-orientation-log"
                            "name" "string" "Quaternion log"
