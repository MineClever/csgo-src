                    "duration" "time" "1.0000"
                    "scale" "float" "1.000000"
                }
                "frameRate" "int" "24"
                "channels" "element_array"
                [
                    "DmeChannel"
                    {
                        "id" "elementid" "source-delta-base-position-channel"
                        "name" "string" "source_delta_joint_position"
