                {
                    "id" "elementid" "source-delta-base-joint-transform"
                    "name" "string" "source_delta_joint"
                    "position" "vector3" "0 0 0"
                    "orientation" "quaternion" "0 0 0 1"
                    "scale" "vector3" "1 1 1"
                }
            }
        ]
        "transform" "DmeTransform"
        {
            "id" "elementid" "source-delta-base-model-transform"
            "position" "vector3" "0 0 0"
            "orientation" "quaternion" "0 0 0 1"
        }
    }
