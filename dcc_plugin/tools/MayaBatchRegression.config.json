  "animation_gate_expectations": {
    "MostComplexSampleSet/vcaanim_VertexAnim": {
      "min_animated_plugs": 2,
      "required_any_suffix_groups": [[".translateX", ".translateY", ".translateZ"], [".rotateX", ".rotateY", ".rotateZ"]]
    },
    "simple_float_animation": {
      "min_animated_plugs": 1,
      "required_any_suffix_groups": [[".scaleX"]]
    },
    "simple_blendshape_animation": {
      "min_animated_plugs": 2,
      "required_substrings": ["combinationOperator_controls.smile", "_blendShape.smile"]
    },
    "MostComplexSampleSet/vcaanim_VertexAnim.smd": {
      "min_animated_plugs": 1,
      "required_any_suffix_groups": [[".translateX", ".translateY", ".translateZ"]]
