// Entry point for the glTF/GLB Import options dialog.
// Called by Maya when the user opens File > Import for glTF files.
global proc int mayaGltfTranslatorImport(
    string $parent,
    string $action,
    string $initialSettings,
    string $resultCallback)
{
    if (!`exists MayaGltfImport_applyOptionsString`)
    {
        source "performGltfImport.mel";
    }

    if ($action == "post")
    {
        GltfImportOptionsUI($parent);
        MayaGltfImport_applyOptionsString($initialSettings);
        return 1;
    }

    if ($action == "fill")
    {
        MayaGltfImport_applyOptionsString($initialSettings);
        return 1;
    }

    if ($action == "query")
    {
        string $optionsString = MayaGltfImport_collectOptionsString();
        eval($resultCallback + " \"" + $optionsString + "\"");
        return 1;
    }

    return 0;
}
