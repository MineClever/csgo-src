global proc MayaDmxImport_setOptionVars(int $forceFactorySettings)
{
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_importMaterials`) { optionVar -intValue MayaDmx_importMaterials 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_importSkin`) { optionVar -intValue MayaDmx_importSkin 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_importDeltaStates`) { optionVar -intValue MayaDmx_importDeltaStates 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_useSceneRoot`) { optionVar -intValue MayaDmx_useSceneRoot 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_importMode`) { optionVar -stringValue MayaDmx_importMode "create"; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_translateX`) { optionVar -floatValue MayaDmx_translateX 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_translateY`) { optionVar -floatValue MayaDmx_translateY 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_translateZ`) { optionVar -floatValue MayaDmx_translateZ 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_rotateX`) { optionVar -floatValue MayaDmx_rotateX 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_rotateY`) { optionVar -floatValue MayaDmx_rotateY 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_rotateZ`) { optionVar -floatValue MayaDmx_rotateZ 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_scaleX`) { optionVar -floatValue MayaDmx_scaleX 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_scaleY`) { optionVar -floatValue MayaDmx_scaleY 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_scaleZ`) { optionVar -floatValue MayaDmx_scaleZ 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_importAnimationToLayer`) { optionVar -intValue MayaDmx_importAnimationToLayer 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_animationLayerMode`) { optionVar -stringValue MayaDmx_animationLayerMode "new"; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_sourceDeltaMode`) { optionVar -stringValue MayaDmx_sourceDeltaMode "none"; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_sourceDeltaUseClip`) { optionVar -intValue MayaDmx_sourceDeltaUseClip 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_sourceDeltaClip`) { optionVar -stringValue MayaDmx_sourceDeltaClip ""; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_sourceDeltaReferenceClip`) { optionVar -stringValue MayaDmx_sourceDeltaReferenceClip ""; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_sourceDeltaTargetClip`) { optionVar -stringValue MayaDmx_sourceDeltaTargetClip ""; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_sourceDeltaReferenceFrame`) { optionVar -intValue MayaDmx_sourceDeltaReferenceFrame 0; }
}

global proc string MayaDmxImport_defaultOptionsString()
{
    return "importMaterials=1;importSkin=1;importDeltaStates=1;useSceneRoot=0;importMode=create;translateX=0;translateY=0;translateZ=0;rotateX=0;rotateY=0;rotateZ=0;scaleX=1;scaleY=1;scaleZ=1;importAnimationToLayer=0;animationLayerMode=new;sourceDeltaMode=none;sourceDeltaUseClip=0;sourceDeltaReferenceFrame=0";
}

global proc string MayaDmxImport_collectOptionVarString()
{
    MayaDmxImport_setOptionVars(0);
    string $options = ("importMaterials=" + `optionVar -q MayaDmx_importMaterials`
        + ";importSkin=" + `optionVar -q MayaDmx_importSkin`
        + ";importDeltaStates=" + `optionVar -q MayaDmx_importDeltaStates`
        + ";useSceneRoot=" + `optionVar -q MayaDmx_useSceneRoot`
        + ";importMode=" + `optionVar -q MayaDmx_importMode`
        + ";translateX=" + `optionVar -q MayaDmx_translateX`
        + ";translateY=" + `optionVar -q MayaDmx_translateY`
        + ";translateZ=" + `optionVar -q MayaDmx_translateZ`
        + ";rotateX=" + `optionVar -q MayaDmx_rotateX`
        + ";rotateY=" + `optionVar -q MayaDmx_rotateY`
        + ";rotateZ=" + `optionVar -q MayaDmx_rotateZ`
        + ";scaleX=" + `optionVar -q MayaDmx_scaleX`
        + ";scaleY=" + `optionVar -q MayaDmx_scaleY`
        + ";scaleZ=" + `optionVar -q MayaDmx_scaleZ`
        + ";importAnimationToLayer=" + `optionVar -q MayaDmx_importAnimationToLayer`
        + ";animationLayerMode=" + `optionVar -q MayaDmx_animationLayerMode`
        + ";sourceDeltaMode=" + `optionVar -q MayaDmx_sourceDeltaMode`
        + ";sourceDeltaUseClip=" + `optionVar -q MayaDmx_sourceDeltaUseClip`
        + ";sourceDeltaReferenceFrame=" + `optionVar -q MayaDmx_sourceDeltaReferenceFrame`);
    string $sceneClip = `optionVar -q MayaDmx_sourceDeltaClip`;
    string $referenceClip = `optionVar -q MayaDmx_sourceDeltaReferenceClip`;
    string $targetClip = `optionVar -q MayaDmx_sourceDeltaTargetClip`;
    if (size($sceneClip) > 0) { $options += (";sourceDeltaClip=" + $sceneClip); }
    if (size($referenceClip) > 0) { $options += (";sourceDeltaReferenceClip=" + $referenceClip); }
    if (size($targetClip) > 0) { $options += (";sourceDeltaTargetClip=" + $targetClip); }
    return $options;
}

global proc string MayaDmxImport_sourceDeltaModeFromControl(string $control)
{
    if (!`optionMenuGrp -exists $control`) { return "none"; }
    int $modeSelect = `optionMenuGrp -q -select $control`;
    if ($modeSelect == 2) { return "subtract"; }
    if ($modeSelect == 3) { return "presubtract"; }
    if ($modeSelect == 4) { return "lineardelta"; }
    if ($modeSelect == 5) { return "splinedelta"; }
    return "none";
}

global proc MayaDmxImport_refreshSourceDeltaClipMenu()
{
    if (!`optionMenuGrp -exists dmxImportSourceDeltaClip`) { return; }
    string $control = "dmxImportSourceDeltaClip";
    string $menu = (`optionMenuGrp -q -fullPathName $control`) + "|OptionMenu";
    if (!`optionMenu -exists $menu`) { return; }

    optionMenu -e -deleteAllItems $menu;
    menuItem -parent $menu -label "None";

    string $layers[] = `ls -type "animLayer"`;
    for ($layer in $layers)
    {
        if (size($layer) == 0)
        {
            continue;
        }
        if ($layer == "BaseAnimation" || $layer == "baseAnimation")
        {
            continue;
        }
        menuItem -parent $menu -label $layer;
    }

    string $selectedClip = "";
    if (`optionVar -exists MayaDmx_sourceDeltaClip`)
    {
        $selectedClip = `optionVar -q MayaDmx_sourceDeltaClip`;
    }

    int $matched = 0;
    if (size($selectedClip) > 0)
    {
        for ($layer in $layers)
        {
            if ($layer == $selectedClip && $layer != "BaseAnimation" && $layer != "baseAnimation")
            {
                $matched = 1;
                optionMenuGrp -e -value $selectedClip $control;
                break;
            }
        }
    }
    if (!$matched)
    {
        optionMenuGrp -e -value "None" $control;
    }
}

global proc string MayaDmxImport_sourceDeltaClipFromControl(string $control)
{
    if (!`optionMenuGrp -exists $control`) { return ""; }
    string $value = `optionMenuGrp -q -value $control`;
    if ($value == "None")
    {
        return "";
    }
    return $value;
}

global proc MayaDmxImport_applyOptionsString(string $options)
{
    string $effectiveOptions = $options;
    if (size($effectiveOptions) == 0) { $effectiveOptions = MayaDmxImport_defaultOptionsString(); }
    int $importMaterials = 1;
    int $importSkin = 1;
    int $importDeltaStates = 1;
    int $useSceneRoot = 0;
    string $importMode = "create";
    float $translateX = 0; float $translateY = 0; float $translateZ = 0;
    float $rotateX = 0; float $rotateY = 0; float $rotateZ = 0;
    float $scaleX = 1; float $scaleY = 1; float $scaleZ = 1;
    int $importAnimationToLayer = 0;
    string $animationLayerMode = "new";
    string $sourceDeltaMode = "none";
    int $sourceDeltaUseClip = 0;
    string $sourceDeltaClip = "";
    string $sourceDeltaReferenceClip = "";
    string $sourceDeltaTargetClip = "";
    int $sourceDeltaReferenceFrame = 0;

    string $optionList[]; tokenize($effectiveOptions, ";", $optionList);
    for ($option in $optionList) {
        string $parts[]; tokenize($option, "=", $parts);
        if (size($parts) < 2) { continue; }
        if ($parts[0] == "importMaterials") { $importMaterials = $parts[1]; }
        else if ($parts[0] == "importSkin") { $importSkin = $parts[1]; }
        else if ($parts[0] == "importDeltaStates") { $importDeltaStates = $parts[1]; }
        else if ($parts[0] == "useSceneRoot") { $useSceneRoot = $parts[1]; }
        else if ($parts[0] == "importMode") { $importMode = $parts[1]; }
        else if ($parts[0] == "translateX") { $translateX = $parts[1]; }
        else if ($parts[0] == "translateY") { $translateY = $parts[1]; }
        else if ($parts[0] == "translateZ") { $translateZ = $parts[1]; }
        else if ($parts[0] == "rotateX") { $rotateX = $parts[1]; }
        else if ($parts[0] == "rotateY") { $rotateY = $parts[1]; }
        else if ($parts[0] == "rotateZ") { $rotateZ = $parts[1]; }
        else if ($parts[0] == "scaleX") { $scaleX = $parts[1]; }
        else if ($parts[0] == "scaleY") { $scaleY = $parts[1]; }
        else if ($parts[0] == "scaleZ") { $scaleZ = $parts[1]; }
        else if ($parts[0] == "importAnimationToLayer") { $importAnimationToLayer = $parts[1]; }
        else if ($parts[0] == "animationLayerMode") { $animationLayerMode = $parts[1]; }
        else if ($parts[0] == "sourceDeltaMode") { $sourceDeltaMode = $parts[1]; }
        else if ($parts[0] == "sourceDeltaUseClip") { $sourceDeltaUseClip = $parts[1]; }
        else if ($parts[0] == "sourceDeltaClip") { $sourceDeltaClip = $parts[1]; }
        else if ($parts[0] == "sourceDeltaReferenceClip") { $sourceDeltaReferenceClip = $parts[1]; }
        else if ($parts[0] == "sourceDeltaTargetClip") { $sourceDeltaTargetClip = $parts[1]; }
        else if ($parts[0] == "sourceDeltaReferenceFrame") { $sourceDeltaReferenceFrame = $parts[1]; }
    }

    if (`checkBoxGrp -exists dmxImportMaterials`) { checkBoxGrp -e -value1 $importMaterials dmxImportMaterials; }
    if (`checkBoxGrp -exists dmxImportSkin`) { checkBoxGrp -e -value1 $importSkin dmxImportSkin; }
    if (`checkBoxGrp -exists dmxImportDeltaStates`) { checkBoxGrp -e -value1 $importDeltaStates dmxImportDeltaStates; }
    if (`checkBoxGrp -exists dmxImportUseSceneRoot`) { checkBoxGrp -e -value1 $useSceneRoot dmxImportUseSceneRoot; }
    if (`optionMenuGrp -exists dmxImportMode`) {
        if ($importMode == "update") { optionMenuGrp -e -select 2 dmxImportMode; }
        else if ($importMode == "append") { optionMenuGrp -e -select 3 dmxImportMode; }
        else if ($importMode == "animationOnly") { optionMenuGrp -e -select 4 dmxImportMode; }
        else { optionMenuGrp -e -select 1 dmxImportMode; }
    }
    if (`floatFieldGrp -exists dmxImportTranslation`) { floatFieldGrp -e -value1 $translateX -value2 $translateY -value3 $translateZ dmxImportTranslation; }
    if (`floatFieldGrp -exists dmxImportRotation`) { floatFieldGrp -e -value1 $rotateX -value2 $rotateY -value3 $rotateZ dmxImportRotation; }
    if (`floatFieldGrp -exists dmxImportScale`) { floatFieldGrp -e -value1 $scaleX -value2 $scaleY -value3 $scaleZ dmxImportScale; }
    if (`checkBoxGrp -exists dmxImportAnimationLayer`) { checkBoxGrp -e -value1 $importAnimationToLayer dmxImportAnimationLayer; }
    if (`optionMenuGrp -exists dmxImportAnimationLayerMode`) {
        if ($animationLayerMode == "replace") { optionMenuGrp -e -select 2 dmxImportAnimationLayerMode; }
        else { optionMenuGrp -e -select 1 dmxImportAnimationLayerMode; }
    }
    if (`checkBoxGrp -exists dmxImportSourceDeltaUseClip`) {
        checkBoxGrp -e -value1 $sourceDeltaUseClip dmxImportSourceDeltaUseClip;
    }
    MayaDmxImport_refreshSourceDeltaClipMenu();
    if (`optionMenuGrp -exists dmxImportSourceDeltaClip`) {
        if (size($sourceDeltaClip) > 0) {
            optionMenuGrp -e -value $sourceDeltaClip dmxImportSourceDeltaClip;
        } else {
            optionMenuGrp -e -value "None" dmxImportSourceDeltaClip;
        }
    }
    if (`optionMenuGrp -exists dmxImportSourceDeltaMode`) {
        if ($sourceDeltaMode == "subtract") { optionMenuGrp -e -select 2 dmxImportSourceDeltaMode; }
        else if ($sourceDeltaMode == "presubtract") { optionMenuGrp -e -select 3 dmxImportSourceDeltaMode; }
        else if ($sourceDeltaMode == "lineardelta") { optionMenuGrp -e -select 4 dmxImportSourceDeltaMode; }
        else if ($sourceDeltaMode == "splinedelta") { optionMenuGrp -e -select 5 dmxImportSourceDeltaMode; }
        else { optionMenuGrp -e -select 1 dmxImportSourceDeltaMode; }
    }
    if (`textFieldGrp -exists dmxImportSourceDeltaReferenceClip`) {
        textFieldGrp -e -text $sourceDeltaReferenceClip dmxImportSourceDeltaReferenceClip;
    }
    if (`textFieldGrp -exists dmxImportSourceDeltaTargetClip`) {
        textFieldGrp -e -text $sourceDeltaTargetClip dmxImportSourceDeltaTargetClip;
    }
    if (`intFieldGrp -exists dmxImportSourceDeltaReferenceFrame`) {
        intFieldGrp -e -value1 $sourceDeltaReferenceFrame dmxImportSourceDeltaReferenceFrame;
    }
    MayaDmxImport_updateAnimationLayerUI();
}

global proc string MayaDmxImport_collectOptionsString()
{
    int $importMaterials = 1;
    int $importSkin = 1;
    int $importDeltaStates = 1;
    int $useSceneRoot = 0;
    if (`checkBoxGrp -exists dmxImportMaterials`) { $importMaterials = `checkBoxGrp -q -value1 dmxImportMaterials`; }
    if (`checkBoxGrp -exists dmxImportSkin`) { $importSkin = `checkBoxGrp -q -value1 dmxImportSkin`; }
    if (`checkBoxGrp -exists dmxImportDeltaStates`) { $importDeltaStates = `checkBoxGrp -q -value1 dmxImportDeltaStates`; }
    if (`checkBoxGrp -exists dmxImportUseSceneRoot`) { $useSceneRoot = `checkBoxGrp -q -value1 dmxImportUseSceneRoot`; }
    string $importMode = "create";
    if (`optionMenuGrp -exists dmxImportMode`) {
        int $modeSelect = `optionMenuGrp -q -select dmxImportMode`;
        if ($modeSelect == 2) { $importMode = "update"; }
        else if ($modeSelect == 3) { $importMode = "append"; }
        else if ($modeSelect == 4) { $importMode = "animationOnly"; }
    }

    float $translateX = 0;
    float $translateY = 0;
    float $translateZ = 0;
    float $rotateX = 0;
    float $rotateY = 0;
    float $rotateZ = 0;
    float $scaleX = 1;
    float $scaleY = 1;
    float $scaleZ = 1;
    if (`floatFieldGrp -exists dmxImportTranslation`) {
        $translateX = `floatFieldGrp -q -value1 dmxImportTranslation`;
        $translateY = `floatFieldGrp -q -value2 dmxImportTranslation`;
        $translateZ = `floatFieldGrp -q -value3 dmxImportTranslation`;
    }
    if (`floatFieldGrp -exists dmxImportRotation`) {
        $rotateX = `floatFieldGrp -q -value1 dmxImportRotation`;
        $rotateY = `floatFieldGrp -q -value2 dmxImportRotation`;
        $rotateZ = `floatFieldGrp -q -value3 dmxImportRotation`;
    }
    if (`floatFieldGrp -exists dmxImportScale`) {
        $scaleX = `floatFieldGrp -q -value1 dmxImportScale`;
        $scaleY = `floatFieldGrp -q -value2 dmxImportScale`;
        $scaleZ = `floatFieldGrp -q -value3 dmxImportScale`;
    }

    int $importAnimationToLayer = 0;
    if (`checkBoxGrp -exists dmxImportAnimationLayer`) {
        $importAnimationToLayer = `checkBoxGrp -q -value1 dmxImportAnimationLayer`;
    }
    string $animationLayerMode = "new";
    if (`optionMenuGrp -exists dmxImportAnimationLayerMode`) {
        if (`optionMenuGrp -q -select dmxImportAnimationLayerMode` == 2) { $animationLayerMode = "replace"; }
    }
    string $sourceDeltaMode = MayaDmxImport_sourceDeltaModeFromControl("dmxImportSourceDeltaMode");
    int $sourceDeltaUseClip = 0;
    if (`checkBoxGrp -exists dmxImportSourceDeltaUseClip`) {
        $sourceDeltaUseClip = `checkBoxGrp -q -value1 dmxImportSourceDeltaUseClip`;
    }
    string $sourceDeltaClip = "";
    if (`optionMenuGrp -exists dmxImportSourceDeltaClip`) {
        $sourceDeltaClip = MayaDmxImport_sourceDeltaClipFromControl("dmxImportSourceDeltaClip");
    }
    string $sourceDeltaReferenceClip = "";
    string $sourceDeltaTargetClip = "";
    int $sourceDeltaReferenceFrame = 0;
    if (`textFieldGrp -exists dmxImportSourceDeltaReferenceClip`) {
        $sourceDeltaReferenceClip = `textFieldGrp -q -text dmxImportSourceDeltaReferenceClip`;
    }
    if (`textFieldGrp -exists dmxImportSourceDeltaTargetClip`) {
        $sourceDeltaTargetClip = `textFieldGrp -q -text dmxImportSourceDeltaTargetClip`;
    }
    if (`intFieldGrp -exists dmxImportSourceDeltaReferenceFrame`) {
        $sourceDeltaReferenceFrame = `intFieldGrp -q -value1 dmxImportSourceDeltaReferenceFrame`;
    }

    string $options = ("importMaterials=" + $importMaterials
        + ";importSkin=" + $importSkin
        + ";importDeltaStates=" + $importDeltaStates
        + ";useSceneRoot=" + $useSceneRoot
        + ";importMode=" + $importMode
        + ";translateX=" + $translateX
        + ";translateY=" + $translateY
        + ";translateZ=" + $translateZ
        + ";rotateX=" + $rotateX
        + ";rotateY=" + $rotateY
        + ";rotateZ=" + $rotateZ
        + ";scaleX=" + $scaleX
        + ";scaleY=" + $scaleY
        + ";scaleZ=" + $scaleZ
        + ";importAnimationToLayer=" + $importAnimationToLayer
        + ";animationLayerMode=" + $animationLayerMode
        + ";sourceDeltaMode=" + $sourceDeltaMode
        + ";sourceDeltaUseClip=" + $sourceDeltaUseClip
        + ";sourceDeltaReferenceFrame=" + $sourceDeltaReferenceFrame);
    if (size($sourceDeltaClip) > 0) { $options += (";sourceDeltaClip=" + $sourceDeltaClip); }
    if (size($sourceDeltaReferenceClip) > 0) { $options += (";sourceDeltaReferenceClip=" + $sourceDeltaReferenceClip); }
    if (size($sourceDeltaTargetClip) > 0) { $options += (";sourceDeltaTargetClip=" + $sourceDeltaTargetClip); }
    return $options;
}

global proc MayaDmx_importSetup(string $parent, int $forceFactorySettings)
{
    MayaDmxImport_setOptionVars($forceFactorySettings);
    setParent $parent;
    MayaDmxImport_applyOptionsString(MayaDmxImport_collectOptionVarString());
}

global proc MayaDmx_importCallback(string $parent, int $doIt)
{
    setParent $parent;
    string $optionString = MayaDmxImport_collectOptionsString();
    MayaDmxImport_applyOptionsString($optionString);
    string $optionList[]; tokenize($optionString, ";", $optionList);
    for ($option in $optionList) {
        string $parts[]; tokenize($option, "=", $parts);
        if (size($parts) < 2) { continue; }
        if ($parts[0] == "importMaterials") { optionVar -intValue MayaDmx_importMaterials $parts[1]; }
        else if ($parts[0] == "importSkin") { optionVar -intValue MayaDmx_importSkin $parts[1]; }
        else if ($parts[0] == "importDeltaStates") { optionVar -intValue MayaDmx_importDeltaStates $parts[1]; }
        else if ($parts[0] == "useSceneRoot") { optionVar -intValue MayaDmx_useSceneRoot $parts[1]; }
        else if ($parts[0] == "importMode") { optionVar -stringValue MayaDmx_importMode $parts[1]; }
        else if ($parts[0] == "translateX") { optionVar -floatValue MayaDmx_translateX $parts[1]; }
        else if ($parts[0] == "translateY") { optionVar -floatValue MayaDmx_translateY $parts[1]; }
        else if ($parts[0] == "translateZ") { optionVar -floatValue MayaDmx_translateZ $parts[1]; }
        else if ($parts[0] == "rotateX") { optionVar -floatValue MayaDmx_rotateX $parts[1]; }
        else if ($parts[0] == "rotateY") { optionVar -floatValue MayaDmx_rotateY $parts[1]; }
        else if ($parts[0] == "rotateZ") { optionVar -floatValue MayaDmx_rotateZ $parts[1]; }
        else if ($parts[0] == "scaleX") { optionVar -floatValue MayaDmx_scaleX $parts[1]; }
        else if ($parts[0] == "scaleY") { optionVar -floatValue MayaDmx_scaleY $parts[1]; }
        else if ($parts[0] == "scaleZ") { optionVar -floatValue MayaDmx_scaleZ $parts[1]; }
        else if ($parts[0] == "importAnimationToLayer") { optionVar -intValue MayaDmx_importAnimationToLayer $parts[1]; }
        else if ($parts[0] == "animationLayerMode") { optionVar -stringValue MayaDmx_animationLayerMode $parts[1]; }
        else if ($parts[0] == "sourceDeltaMode") { optionVar -stringValue MayaDmx_sourceDeltaMode $parts[1]; }
        else if ($parts[0] == "sourceDeltaUseClip") { optionVar -intValue MayaDmx_sourceDeltaUseClip $parts[1]; }
        else if ($parts[0] == "sourceDeltaClip") { optionVar -stringValue MayaDmx_sourceDeltaClip $parts[1]; }
        else if ($parts[0] == "sourceDeltaReferenceClip") { optionVar -stringValue MayaDmx_sourceDeltaReferenceClip $parts[1]; }
        else if ($parts[0] == "sourceDeltaTargetClip") { optionVar -stringValue MayaDmx_sourceDeltaTargetClip $parts[1]; }
        else if ($parts[0] == "sourceDeltaReferenceFrame") { optionVar -intValue MayaDmx_sourceDeltaReferenceFrame $parts[1]; }
    }
    if ($doIt) { performDmxImport 0; }
}

// Updates enabled/disabled state of animation layer controls based on current mode selection.
global proc MayaDmxImport_updateAnimationLayerUI()
{
    int $supportsLayer = 0;
    int $supportsSourceDelta = 0;
    if (`optionMenuGrp -exists dmxImportMode`) {
        int $modeSelect = `optionMenuGrp -q -select dmxImportMode`;
        $supportsLayer = ($modeSelect == 2 || $modeSelect == 4);
        $supportsSourceDelta = ($modeSelect == 2);
    }
    int $importToLayer = 0;
    if (`checkBoxGrp -exists dmxImportAnimationLayer`) {
        checkBoxGrp -e -enable $supportsLayer dmxImportAnimationLayer;
        $importToLayer = `checkBoxGrp -q -value1 dmxImportAnimationLayer`;
    }
    string $sourceDeltaMode = MayaDmxImport_sourceDeltaModeFromControl("dmxImportSourceDeltaMode");
    int $useSourceDelta = ($supportsSourceDelta && $sourceDeltaMode != "none");
    if (`optionMenuGrp -exists dmxImportAnimationLayerMode`) {
        optionMenuGrp -e -enable ($supportsLayer && ($importToLayer || $useSourceDelta)) dmxImportAnimationLayerMode;
    }
    if (`optionMenuGrp -exists dmxImportSourceDeltaMode`) {
        optionMenuGrp -e -enable $supportsSourceDelta dmxImportSourceDeltaMode;
    }
    int $useSceneClip = 0;
    if (`checkBoxGrp -exists dmxImportSourceDeltaUseClip`) {
        $useSceneClip = `checkBoxGrp -q -value1 dmxImportSourceDeltaUseClip`;
        checkBoxGrp -e -enable $supportsSourceDelta dmxImportSourceDeltaUseClip;
    }
    if (`optionMenuGrp -exists dmxImportSourceDeltaClip`) {
        optionMenuGrp -e -enable ($supportsSourceDelta && $useSourceDelta && $useSceneClip) dmxImportSourceDeltaClip;
    }
    if (`textFieldGrp -exists dmxImportSourceDeltaReferenceClip`) {
        textFieldGrp -e -enable ($useSourceDelta && !$useSceneClip) dmxImportSourceDeltaReferenceClip;
    }
    if (`textFieldGrp -exists dmxImportSourceDeltaTargetClip`) {
        textFieldGrp -e -enable ($useSourceDelta && !$useSceneClip) dmxImportSourceDeltaTargetClip;
        if ($useSceneClip) {
            textFieldGrp -e -text "" dmxImportSourceDeltaTargetClip;
        }
    }
    if (`intFieldGrp -exists dmxImportSourceDeltaReferenceFrame`) {
        intFieldGrp -e -enable $useSourceDelta dmxImportSourceDeltaReferenceFrame;
    }
    if ($supportsSourceDelta && $useSourceDelta && $useSceneClip) {
        MayaDmxImport_refreshSourceDeltaClipMenu();
    }
}

global proc string DmxImportOptionsUI(string $parent)
{
    setParent $parent;
    setUITemplate -pushTemplate DefaultTemplate;
    waitCursor -state 1;
    string $optionLayout = `scrollLayout`;
        columnLayout -adjustableColumn true;
            checkBoxGrp -numberOfCheckBoxes 1 -label "Materials" -label1 "Import Face Set Materials" dmxImportMaterials;
            checkBoxGrp -numberOfCheckBoxes 1 -label "Skinning" -label1 "Import Skin Weights" dmxImportSkin;
            checkBoxGrp -numberOfCheckBoxes 1 -label "Deformers" -label1 "Import Delta States" dmxImportDeltaStates;
            checkBoxGrp -numberOfCheckBoxes 1 -label "Root Target" -label1 "Import Directly Into Scene Root" -annotation "When enabled, import skips the dedicated wrapper root and places content directly in the Maya scene." dmxImportUseSceneRoot;
            optionMenuGrp -label "Merge Mode" -annotation "Create creates new nodes. Update reuses matching nodes and overwrites supported mesh/deformer/animation data. Append only fills missing nodes and preserves existing values. Animation Only only targets matching existing scene nodes and skips geometry import." -changeCommand "MayaDmxImport_updateAnimationLayerUI" dmxImportMode;
                menuItem -label "Create New";
                menuItem -label "Update Existing";
                menuItem -label "Append Missing";
                menuItem -label "Animation Only";
            separator -style "in";
            text -align "left" -label "Animation Layer  (Update / Animation Only)";
            checkBoxGrp -numberOfCheckBoxes 1
                -label "Layer Import"
                -label1 "Write Imported Animation To Animation Layer"
                -annotation "Routes imported transform and scalar animation into a Maya override animation layer instead of writing directly to base animation curves."
                -changeCommand "MayaDmxImport_updateAnimationLayerUI"
                dmxImportAnimationLayer;
            optionMenuGrp
                -label "Layer Mode"
                -annotation "New Layer keeps an existing layer if the resolved layer name already exists. Replace Existing Layer deletes and recreates that layer before import."
                dmxImportAnimationLayerMode;
                menuItem -label "New Layer";
                menuItem -label "Replace Existing Layer";
            separator -style "in";
            text -align "left" -label "Source Delta  (Update Only)";
            optionMenuGrp
                -label "Delta Mode"
                -annotation "Interprets imported transform animation as Source-style delta data and routes it through an animation layer. Leave Reference Clip blank to use the current scene state as the reference."
                -changeCommand "MayaDmxImport_updateAnimationLayerUI"
                dmxImportSourceDeltaMode;
                menuItem -label "Disabled";
                menuItem -label "Subtract";
                menuItem -label "PreSubtract";
                menuItem -label "Linear Delta";
                menuItem -label "Spline Delta";
            checkBoxGrp -numberOfCheckBoxes 1
                -label "Use Clip"
                -label1 "Use Scene Animation Layer"
                -annotation "When enabled, the source delta reference samples are read from a scene animation layer instead of a clip in the imported file."
                -changeCommand "MayaDmxImport_updateAnimationLayerUI"
                dmxImportSourceDeltaUseClip;
            optionMenuGrp
                -label "Scene Clip"
                -annotation "Select a scene animation layer to use as the source delta reference. None falls back to the current scene state."
                dmxImportSourceDeltaClip;
                menuItem -label "None";
            textFieldGrp -label "Reference Clip" -annotation "Optional imported clip name. Leave blank to use the current scene state as the reference." dmxImportSourceDeltaReferenceClip;
            textFieldGrp -label "Target Clip" -annotation "Optional imported clip name filter. When set, only this target clip is imported as source delta." dmxImportSourceDeltaTargetClip;
            intFieldGrp -numberOfFields 1 -label "Reference Frame" -annotation "Reference frame index used when sampling an imported reference clip." dmxImportSourceDeltaReferenceFrame;
            separator -style "in";
            text -align "left" -label "Transform Correction";
            text -align "left" -label "Applied directly during import as translation, rotation and scale correction.\n Namespace options use Maya's native Import file panel.";
            floatFieldGrp -numberOfFields 3 -label "Translation" -annotation "Applied directly during import before nodes are written into the Maya scene." dmxImportTranslation;
            floatFieldGrp -numberOfFields 3 -label "Rotation" -annotation "Degrees. Applied directly during import instead of creating a correction wrapper node." dmxImportRotation;
            floatFieldGrp -numberOfFields 3 -label "Scale" -annotation "Scale correction applied directly during import. Animated roots are best used with uniform scale." dmxImportScale;
        setParent ..;
    setParent ..;
    waitCursor -state 0;
    setUITemplate -popTemplate;
    return $optionLayout;
}

global proc DmxImportOptions()
{
    string $callback = "MayaDmx_importCallback";
    string $setup = "MayaDmx_importSetup";
    string $layout = getOptionBox();
    setOptionBoxCommandName("DmxImport");
    string $parent = DmxImportOptionsUI($layout);
    string $importBtn = getOptionBoxApplyBtn();
    string $saveBtn = getOptionBoxSaveBtn();
    string $resetBtn = getOptionBoxResetBtn();
    button -e -label "Import" -command ($callback + " " + $parent + " 1") $importBtn;
    button -e -command ($callback + " " + $parent + " 0; hideOptionBox") $saveBtn;
    button -e -command ($setup + " " + $parent + " 1") $resetBtn;
    setOptionBoxTitle("Valve DMX Import");
    setOptionBoxHelpTag("DmxImport");
    eval($setup + " " + $parent + " 0");
    showOptionBox();
}

global proc string[] captureDmxImportOptionVars(string $version)
{
    MayaDmxImport_setOptionVars(0);
    string $args[];
    $args[0] = `optionVar -q MayaDmx_importMaterials`;
    $args[1] = `optionVar -q MayaDmx_importSkin`;
    $args[2] = `optionVar -q MayaDmx_importDeltaStates`;
    $args[3] = `optionVar -q MayaDmx_useSceneRoot`;
    $args[4] = `optionVar -q MayaDmx_importMode`;
    $args[5] = `optionVar -q MayaDmx_translateX`;
    $args[6] = `optionVar -q MayaDmx_translateY`;
    $args[7] = `optionVar -q MayaDmx_translateZ`;
    $args[8] = `optionVar -q MayaDmx_rotateX`;
    $args[9] = `optionVar -q MayaDmx_rotateY`;
    $args[10] = `optionVar -q MayaDmx_rotateZ`;
    $args[11] = `optionVar -q MayaDmx_scaleX`;
    $args[12] = `optionVar -q MayaDmx_scaleY`;
    $args[13] = `optionVar -q MayaDmx_scaleZ`;
    $args[14] = `optionVar -q MayaDmx_importAnimationToLayer`;
    $args[15] = `optionVar -q MayaDmx_animationLayerMode`;
    $args[16] = `optionVar -q MayaDmx_sourceDeltaMode`;
    $args[17] = `optionVar -q MayaDmx_sourceDeltaUseClip`;
    $args[18] = `optionVar -q MayaDmx_sourceDeltaClip`;
    $args[19] = `optionVar -q MayaDmx_sourceDeltaReferenceClip`;
    $args[20] = `optionVar -q MayaDmx_sourceDeltaTargetClip`;
    $args[21] = `optionVar -q MayaDmx_sourceDeltaReferenceFrame`;
    return $args;
}

global proc string assembleDmxImportCmd()
{
    int $version = 1;
    string $args[] = captureDmxImportOptionVars($version);
    string $cmd = "doDmxImportArgList " + $version + " {";
    int $i;
    for ($i = 0; $i < size($args); ++$i) {
        if ($i > 0) { $cmd += ","; }
        $cmd += ("\"" + encodeString($args[$i]) + "\"");
    }
    $cmd += "};";
    return $cmd;
}

global proc MayaDmx_importFileOptionsUICreate(string $parent) { DmxImportOptionsUI($parent); }
global proc MayaDmx_importFileOptionsUIInit(string $parent, string $filter) { MayaDmx_importSetup($parent, 0); }
global proc MayaDmx_importFileOptionsUICommit(string $parent) { MayaDmx_importCallback($parent, 0); }

global proc string performDmxImport(int $action)
{
    string $cmd = "";
    switch ($action) {
    case 0: $cmd = assembleDmxImportCmd(); eval($cmd); break;
    case 1: DmxImportOptions(); break;
    case 2: $cmd = assembleDmxImportCmd(); break;
    }
    return $cmd;
}
