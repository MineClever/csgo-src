global proc MayaSmdImport_setOptionVars(int $forceFactorySettings)
{
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_useSceneRoot`) { optionVar -intValue MayaSmd_useSceneRoot 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_importMode`) { optionVar -stringValue MayaSmd_importMode "create"; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_translateX`) { optionVar -floatValue MayaSmd_translateX 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_translateY`) { optionVar -floatValue MayaSmd_translateY 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_translateZ`) { optionVar -floatValue MayaSmd_translateZ 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_rotateX`) { optionVar -floatValue MayaSmd_rotateX 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_rotateY`) { optionVar -floatValue MayaSmd_rotateY 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_rotateZ`) { optionVar -floatValue MayaSmd_rotateZ 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_scaleX`) { optionVar -floatValue MayaSmd_scaleX 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_scaleY`) { optionVar -floatValue MayaSmd_scaleY 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_scaleZ`) { optionVar -floatValue MayaSmd_scaleZ 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_importAnimationToLayer`) { optionVar -intValue MayaSmd_importAnimationToLayer 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_animationLayerMode`) { optionVar -stringValue MayaSmd_animationLayerMode "new"; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_sourceDeltaMode`) { optionVar -stringValue MayaSmd_sourceDeltaMode "none"; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_sourceDeltaUseClip`) { optionVar -intValue MayaSmd_sourceDeltaUseClip 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_sourceDeltaClip`) { optionVar -stringValue MayaSmd_sourceDeltaClip ""; }
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_sourceDeltaReferenceFrame`) { optionVar -intValue MayaSmd_sourceDeltaReferenceFrame 0; }
}

global proc string MayaSmdImport_defaultOptionsString()
{
    return "useSceneRoot=0;importMode=create;translateX=0;translateY=0;translateZ=0;rotateX=0;rotateY=0;rotateZ=0;scaleX=1;scaleY=1;scaleZ=1;importAnimationToLayer=0;animationLayerMode=new;sourceDeltaMode=none;sourceDeltaUseClip=0;sourceDeltaReferenceFrame=0";
}

global proc string MayaSmdImport_collectOptionVarString()
{
    MayaSmdImport_setOptionVars(0);
    string $options = ("useSceneRoot=" + `optionVar -q MayaSmd_useSceneRoot`
        + ";importMode=" + `optionVar -q MayaSmd_importMode`
        + ";translateX=" + `optionVar -q MayaSmd_translateX`
        + ";translateY=" + `optionVar -q MayaSmd_translateY`
        + ";translateZ=" + `optionVar -q MayaSmd_translateZ`
        + ";rotateX=" + `optionVar -q MayaSmd_rotateX`
        + ";rotateY=" + `optionVar -q MayaSmd_rotateY`
        + ";rotateZ=" + `optionVar -q MayaSmd_rotateZ`
        + ";scaleX=" + `optionVar -q MayaSmd_scaleX`
        + ";scaleY=" + `optionVar -q MayaSmd_scaleY`
        + ";scaleZ=" + `optionVar -q MayaSmd_scaleZ`
        + ";importAnimationToLayer=" + `optionVar -q MayaSmd_importAnimationToLayer`
        + ";animationLayerMode=" + `optionVar -q MayaSmd_animationLayerMode`
        + ";sourceDeltaMode=" + `optionVar -q MayaSmd_sourceDeltaMode`
        + ";sourceDeltaUseClip=" + `optionVar -q MayaSmd_sourceDeltaUseClip`
        + ";sourceDeltaReferenceFrame=" + `optionVar -q MayaSmd_sourceDeltaReferenceFrame`);
    string $sourceDeltaClip = `optionVar -q MayaSmd_sourceDeltaClip`;
    if (size($sourceDeltaClip) > 0) {
        $options += (";sourceDeltaClip=" + $sourceDeltaClip);
    }
    return $options;
}

global proc MayaSmdImport_refreshSourceDeltaClipMenu()
{
    if (!`optionMenuGrp -exists smdImportSourceDeltaClip`) { return; }
    string $control = "smdImportSourceDeltaClip";
    string $menu = (`optionMenuGrp -q -fullPathName $control`) + "|OptionMenu";
    if (!`optionMenu -exists $menu`) { return; }

    optionMenu -e -deleteAllItems $menu;
    menuItem -parent $menu -label "None";

    string $layers[] = `ls -type "animLayer"`;
    for ($layer in $layers)
    {
        if (size($layer) == 0 || $layer == "BaseAnimation" || $layer == "baseAnimation")
        {
            continue;
        }
        menuItem -parent $menu -label $layer;
    }

    string $selectedClip = "";
    if (`optionVar -exists MayaSmd_sourceDeltaClip`)
    {
        $selectedClip = `optionVar -q MayaSmd_sourceDeltaClip`;
    }

    int $matched = 0;
    if (size($selectedClip) > 0)
    {
        for ($layer in $layers)
        {
            if ($layer == $selectedClip && $layer != "BaseAnimation" && $layer != "baseAnimation")
            {
                $matched = 1;
                optionMenuGrp -e -value $selectedClip $control;
                break;
            }
        }
    }
    if (!$matched)
    {
        optionMenuGrp -e -value "None" $control;
    }
}

global proc string MayaSmdImport_sourceDeltaModeFromControl(string $control)
{
    if (!`optionMenuGrp -exists $control`) { return "none"; }
    int $modeSelect = `optionMenuGrp -q -select $control`;
    if ($modeSelect == 2) { return "subtract"; }
    if ($modeSelect == 3) { return "presubtract"; }
    if ($modeSelect == 4) { return "lineardelta"; }
    if ($modeSelect == 5) { return "splinedelta"; }
    return "none";
}

global proc MayaSmdImport_applyOptionsString(string $options)
{
    string $effectiveOptions = $options;
    if (size($effectiveOptions) == 0) { $effectiveOptions = MayaSmdImport_defaultOptionsString(); }
    int $useSceneRoot = 0;
    string $importMode = "create";
    float $translateX = 0; float $translateY = 0; float $translateZ = 0;
    float $rotateX = 0; float $rotateY = 0; float $rotateZ = 0;
    float $scaleX = 1; float $scaleY = 1; float $scaleZ = 1;
    int $importAnimationToLayer = 0;
    string $animationLayerMode = "new";
    string $sourceDeltaMode = "none";
    int $sourceDeltaUseClip = 0;
    string $sourceDeltaClip = "";
    int $sourceDeltaReferenceFrame = 0;

    string $optionList[]; tokenize($effectiveOptions, ";", $optionList);
    for ($option in $optionList) {
        string $parts[]; tokenize($option, "=", $parts);
        if (size($parts) < 2) { continue; }
        if ($parts[0] == "useSceneRoot") { $useSceneRoot = $parts[1]; }
        else if ($parts[0] == "importMode") { $importMode = $parts[1]; }
        else if ($parts[0] == "translateX") { $translateX = $parts[1]; }
        else if ($parts[0] == "translateY") { $translateY = $parts[1]; }
        else if ($parts[0] == "translateZ") { $translateZ = $parts[1]; }
        else if ($parts[0] == "rotateX") { $rotateX = $parts[1]; }
        else if ($parts[0] == "rotateY") { $rotateY = $parts[1]; }
        else if ($parts[0] == "rotateZ") { $rotateZ = $parts[1]; }
        else if ($parts[0] == "scaleX") { $scaleX = $parts[1]; }
        else if ($parts[0] == "scaleY") { $scaleY = $parts[1]; }
        else if ($parts[0] == "scaleZ") { $scaleZ = $parts[1]; }
        else if ($parts[0] == "importAnimationToLayer") { $importAnimationToLayer = $parts[1]; }
        else if ($parts[0] == "animationLayerMode") { $animationLayerMode = $parts[1]; }
        else if ($parts[0] == "sourceDeltaMode") { $sourceDeltaMode = $parts[1]; }
        else if ($parts[0] == "sourceDeltaUseClip") { $sourceDeltaUseClip = $parts[1]; }
        else if ($parts[0] == "sourceDeltaClip") { $sourceDeltaClip = $parts[1]; }
        else if ($parts[0] == "sourceDeltaReferenceFrame") { $sourceDeltaReferenceFrame = $parts[1]; }
    }

    if (`checkBoxGrp -exists smdImportUseSceneRoot`) { checkBoxGrp -e -value1 $useSceneRoot smdImportUseSceneRoot; }
    if (`optionMenuGrp -exists smdImportMode`) {
        if ($importMode == "update") { optionMenuGrp -e -select 2 smdImportMode; }
        else if ($importMode == "append") { optionMenuGrp -e -select 3 smdImportMode; }
        else if ($importMode == "animationOnly") { optionMenuGrp -e -select 4 smdImportMode; }
        else { optionMenuGrp -e -select 1 smdImportMode; }
    }
    if (`floatFieldGrp -exists smdImportTranslation`) { floatFieldGrp -e -value1 $translateX -value2 $translateY -value3 $translateZ smdImportTranslation; }
    if (`floatFieldGrp -exists smdImportRotation`) { floatFieldGrp -e -value1 $rotateX -value2 $rotateY -value3 $rotateZ smdImportRotation; }
    if (`floatFieldGrp -exists smdImportScale`) { floatFieldGrp -e -value1 $scaleX -value2 $scaleY -value3 $scaleZ smdImportScale; }
    if (`checkBoxGrp -exists smdImportAnimationLayer`) { checkBoxGrp -e -value1 $importAnimationToLayer smdImportAnimationLayer; }
    if (`optionMenuGrp -exists smdImportAnimationLayerMode`) {
        if ($animationLayerMode == "replace") { optionMenuGrp -e -select 2 smdImportAnimationLayerMode; }
        else { optionMenuGrp -e -select 1 smdImportAnimationLayerMode; }
    }
    if (`optionMenuGrp -exists smdImportSourceDeltaMode`) {
        if ($sourceDeltaMode == "subtract") { optionMenuGrp -e -select 2 smdImportSourceDeltaMode; }
        else if ($sourceDeltaMode == "presubtract") { optionMenuGrp -e -select 3 smdImportSourceDeltaMode; }
        else if ($sourceDeltaMode == "lineardelta") { optionMenuGrp -e -select 4 smdImportSourceDeltaMode; }
        else if ($sourceDeltaMode == "splinedelta") { optionMenuGrp -e -select 5 smdImportSourceDeltaMode; }
        else { optionMenuGrp -e -select 1 smdImportSourceDeltaMode; }
    }
    if (`checkBoxGrp -exists smdImportSourceDeltaUseClip`) {
        checkBoxGrp -e -value1 $sourceDeltaUseClip smdImportSourceDeltaUseClip;
    }
    MayaSmdImport_refreshSourceDeltaClipMenu();
    if (`optionMenuGrp -exists smdImportSourceDeltaClip`) {
        if (size($sourceDeltaClip) > 0) {
            optionMenuGrp -e -value $sourceDeltaClip smdImportSourceDeltaClip;
        } else {
            optionMenuGrp -e -value "None" smdImportSourceDeltaClip;
        }
    }
    if (`intFieldGrp -exists smdImportSourceDeltaReferenceFrame`) {
        intFieldGrp -e -value1 $sourceDeltaReferenceFrame smdImportSourceDeltaReferenceFrame;
    }
    MayaSmdImport_updateAnimationLayerUI();
}

global proc string MayaSmdImport_collectOptionsString()
{
    int $useSceneRoot = 0;
    if (`checkBoxGrp -exists smdImportUseSceneRoot`) { $useSceneRoot = `checkBoxGrp -q -value1 smdImportUseSceneRoot`; }
    string $importMode = "create";
    if (`optionMenuGrp -exists smdImportMode`) {
        int $modeSelect = `optionMenuGrp -q -select smdImportMode`;
        if ($modeSelect == 2) { $importMode = "update"; }
        else if ($modeSelect == 3) { $importMode = "append"; }
        else if ($modeSelect == 4) { $importMode = "animationOnly"; }
    }
    float $translateX = 0;
    float $translateY = 0;
    float $translateZ = 0;
    float $rotateX = 0;
    float $rotateY = 0;
    float $rotateZ = 0;
    float $scaleX = 1;
    float $scaleY = 1;
    float $scaleZ = 1;
    if (`floatFieldGrp -exists smdImportTranslation`) {
        $translateX = `floatFieldGrp -q -value1 smdImportTranslation`;
        $translateY = `floatFieldGrp -q -value2 smdImportTranslation`;
        $translateZ = `floatFieldGrp -q -value3 smdImportTranslation`;
    }
    if (`floatFieldGrp -exists smdImportRotation`) {
        $rotateX = `floatFieldGrp -q -value1 smdImportRotation`;
        $rotateY = `floatFieldGrp -q -value2 smdImportRotation`;
        $rotateZ = `floatFieldGrp -q -value3 smdImportRotation`;
    }
    if (`floatFieldGrp -exists smdImportScale`) {
        $scaleX = `floatFieldGrp -q -value1 smdImportScale`;
        $scaleY = `floatFieldGrp -q -value2 smdImportScale`;
        $scaleZ = `floatFieldGrp -q -value3 smdImportScale`;
    }
    int $importAnimationToLayer = 0;
    if (`checkBoxGrp -exists smdImportAnimationLayer`) {
        $importAnimationToLayer = `checkBoxGrp -q -value1 smdImportAnimationLayer`;
    }
    string $animationLayerMode = "new";
    if (`optionMenuGrp -exists smdImportAnimationLayerMode`) {
        if (`optionMenuGrp -q -select smdImportAnimationLayerMode` == 2) { $animationLayerMode = "replace"; }
    }
    string $sourceDeltaMode = MayaSmdImport_sourceDeltaModeFromControl("smdImportSourceDeltaMode");
    int $sourceDeltaUseClip = 0;
    if (`checkBoxGrp -exists smdImportSourceDeltaUseClip`) {
        $sourceDeltaUseClip = `checkBoxGrp -q -value1 smdImportSourceDeltaUseClip`;
    }
    string $sourceDeltaClip = "";
    if (`optionMenuGrp -exists smdImportSourceDeltaClip`) {
        $sourceDeltaClip = `optionMenuGrp -q -value smdImportSourceDeltaClip`;
        if ($sourceDeltaClip == "None") { $sourceDeltaClip = ""; }
    }
    int $sourceDeltaReferenceFrame = 0;
    if (`intFieldGrp -exists smdImportSourceDeltaReferenceFrame`) {
        $sourceDeltaReferenceFrame = `intFieldGrp -q -value1 smdImportSourceDeltaReferenceFrame`;
    }

    string $options = ("useSceneRoot=" + $useSceneRoot
        + ";importMode=" + $importMode
        + ";translateX=" + $translateX
        + ";translateY=" + $translateY
        + ";translateZ=" + $translateZ
        + ";rotateX=" + $rotateX
        + ";rotateY=" + $rotateY
        + ";rotateZ=" + $rotateZ
        + ";scaleX=" + $scaleX
        + ";scaleY=" + $scaleY
        + ";scaleZ=" + $scaleZ
        + ";importAnimationToLayer=" + $importAnimationToLayer
        + ";animationLayerMode=" + $animationLayerMode
        + ";sourceDeltaMode=" + $sourceDeltaMode
        + ";sourceDeltaUseClip=" + $sourceDeltaUseClip
        + ";sourceDeltaReferenceFrame=" + $sourceDeltaReferenceFrame);
    if (size($sourceDeltaClip) > 0) { $options += (";sourceDeltaClip=" + $sourceDeltaClip); }
    return $options;
}

global proc MayaSmdImport_updateAnimationLayerUI()
{
    int $supportsLayer = 0;
    int $supportsSourceDelta = 0;
    if (`optionMenuGrp -exists smdImportMode`) {
        int $modeSelect = `optionMenuGrp -q -select smdImportMode`;
        $supportsLayer = ($modeSelect == 2 || $modeSelect == 4);
        $supportsSourceDelta = ($modeSelect == 2);
    }
    int $importToLayer = 0;
    if (`checkBoxGrp -exists smdImportAnimationLayer`) {
        checkBoxGrp -e -enable $supportsLayer smdImportAnimationLayer;
        $importToLayer = `checkBoxGrp -q -value1 smdImportAnimationLayer`;
    }
    string $sourceDeltaMode = MayaSmdImport_sourceDeltaModeFromControl("smdImportSourceDeltaMode");
    int $useSourceDelta = ($supportsSourceDelta && $sourceDeltaMode != "none");
    if (`optionMenuGrp -exists smdImportAnimationLayerMode`) {
        optionMenuGrp -e -enable ($supportsLayer && ($importToLayer || $useSourceDelta)) smdImportAnimationLayerMode;
    }
    if (`optionMenuGrp -exists smdImportSourceDeltaMode`) {
        optionMenuGrp -e -enable $supportsSourceDelta smdImportSourceDeltaMode;
    }
    int $useSceneClip = 0;
    if (`checkBoxGrp -exists smdImportSourceDeltaUseClip`) {
        $useSceneClip = `checkBoxGrp -q -value1 smdImportSourceDeltaUseClip`;
        checkBoxGrp -e -enable $supportsSourceDelta smdImportSourceDeltaUseClip;
    }
    if (`optionMenuGrp -exists smdImportSourceDeltaClip`) {
        optionMenuGrp -e -enable ($supportsSourceDelta && $useSourceDelta && $useSceneClip) smdImportSourceDeltaClip;
    }
    if (`intFieldGrp -exists smdImportSourceDeltaReferenceFrame`) {
        intFieldGrp -e -enable $useSourceDelta smdImportSourceDeltaReferenceFrame;
    }
    if ($supportsSourceDelta && $useSourceDelta && $useSceneClip) {
        MayaSmdImport_refreshSourceDeltaClipMenu();
    }
}

global proc string SmdImportOptionsUI(string $parent)
{
    setParent $parent;
    setUITemplate -pushTemplate DefaultTemplate;
    waitCursor -state 1;
    string $optionLayout = `scrollLayout`;
        columnLayout -adjustableColumn true;
            checkBoxGrp -numberOfCheckBoxes 1 -label "Root Target" -label1 "Import Directly Into Scene Root" -annotation "When enabled, import skips the dedicated wrapper root and places content directly in the Maya scene." smdImportUseSceneRoot;
            optionMenuGrp -label "Merge Mode" -annotation "Create creates new nodes. Update reuses matching hierarchy, mesh groups and supported skin data. Append only fills missing nodes. Animation Only only targets matching existing scene joints and skips geometry import." -changeCommand "MayaSmdImport_updateAnimationLayerUI" smdImportMode;
                menuItem -label "Create New";
                menuItem -label "Update Existing";
                menuItem -label "Append Missing";
                menuItem -label "Animation Only";
            separator -style "in";
            text -align "left" -label "Animation Layer  (Update / Animation Only)";
            checkBoxGrp -numberOfCheckBoxes 1
                -label "Layer Import"
                -label1 "Write Imported Animation To Animation Layer"
                -annotation "Routes imported SMD transform animation into a Maya override animation layer instead of writing directly to base animation curves."
                -changeCommand "MayaSmdImport_updateAnimationLayerUI"
                smdImportAnimationLayer;
            optionMenuGrp
                -label "Layer Mode"
                -annotation "New Layer keeps an existing layer if the resolved layer name already exists. Replace Existing Layer deletes and recreates that layer before import."
                smdImportAnimationLayerMode;
                menuItem -label "New Layer";
                menuItem -label "Replace Existing Layer";
            separator -style "in";
            text -align "left" -label "Source Delta  (Update Only)";
            optionMenuGrp
                -label "Delta Mode"
                -annotation "SMD source delta writes transform channels through an animation layer. Subtract / PreSubtract use the current scene state as reference."
                -changeCommand "MayaSmdImport_updateAnimationLayerUI"
                smdImportSourceDeltaMode;
                menuItem -label "Disabled";
                menuItem -label "Subtract";
                menuItem -label "PreSubtract";
                menuItem -label "Linear Delta";
                menuItem -label "Spline Delta";
            checkBoxGrp -numberOfCheckBoxes 1
                -label "Use Clip"
                -label1 "Use Scene Animation Layer"
                -annotation "When enabled, source delta reference samples come from a scene animation layer instead of the current scene state."
                -changeCommand "MayaSmdImport_updateAnimationLayerUI"
                smdImportSourceDeltaUseClip;
            optionMenuGrp
                -label "Scene Clip"
                -annotation "Select a scene animation layer to use as the source delta reference. None falls back to the current scene state."
                smdImportSourceDeltaClip;
                menuItem -label "None";
            intFieldGrp -numberOfFields 1 -label "Reference Frame" -annotation "Reference frame index used when sampling the scene layer reference." smdImportSourceDeltaReferenceFrame;
            separator -style "in";
            text -align "left" -label "Transform Correction";
            text -align "left" -label "Applied directly during import as translation, rotation and scale correction.\n Namespace options use Maya's native Import file panel.";
            floatFieldGrp -numberOfFields 3 -label "Translation" -annotation "Applied directly during import before nodes are written into the Maya scene." smdImportTranslation;
            floatFieldGrp -numberOfFields 3 -label "Rotation" -annotation "Degrees. Applied directly during import instead of creating a correction wrapper node." smdImportRotation;
            floatFieldGrp -numberOfFields 3 -label "Scale" -annotation "Scale correction applied directly during import. Animated roots are best used with uniform scale." smdImportScale;
        setParent ..;
    setParent ..;
    waitCursor -state 0;
    setUITemplate -popTemplate;
    return $optionLayout;
}

global proc MayaSmd_importFileOptionsUICreate(string $parent) { SmdImportOptionsUI($parent); }
global proc MayaSmd_importFileOptionsUIInit(string $parent, string $filter) { MayaSmdImport_setOptionVars(0); MayaSmdImport_applyOptionsString(MayaSmdImport_collectOptionVarString()); }

global proc MayaSmd_importFileOptionsUICommit(string $parent)
{
    string $optionString = MayaSmdImport_collectOptionsString();
    MayaSmdImport_applyOptionsString($optionString);
    string $optionList[]; tokenize($optionString, ";", $optionList);
    for ($option in $optionList) {
        string $parts[]; tokenize($option, "=", $parts);
        if (size($parts) < 2) { continue; }
        if ($parts[0] == "useSceneRoot") { optionVar -intValue MayaSmd_useSceneRoot $parts[1]; }
        else if ($parts[0] == "importMode") { optionVar -stringValue MayaSmd_importMode $parts[1]; }
        else if ($parts[0] == "translateX") { optionVar -floatValue MayaSmd_translateX $parts[1]; }
        else if ($parts[0] == "translateY") { optionVar -floatValue MayaSmd_translateY $parts[1]; }
        else if ($parts[0] == "translateZ") { optionVar -floatValue MayaSmd_translateZ $parts[1]; }
        else if ($parts[0] == "rotateX") { optionVar -floatValue MayaSmd_rotateX $parts[1]; }
        else if ($parts[0] == "rotateY") { optionVar -floatValue MayaSmd_rotateY $parts[1]; }
        else if ($parts[0] == "rotateZ") { optionVar -floatValue MayaSmd_rotateZ $parts[1]; }
        else if ($parts[0] == "scaleX") { optionVar -floatValue MayaSmd_scaleX $parts[1]; }
        else if ($parts[0] == "scaleY") { optionVar -floatValue MayaSmd_scaleY $parts[1]; }
        else if ($parts[0] == "scaleZ") { optionVar -floatValue MayaSmd_scaleZ $parts[1]; }
        else if ($parts[0] == "importAnimationToLayer") { optionVar -intValue MayaSmd_importAnimationToLayer $parts[1]; }
        else if ($parts[0] == "animationLayerMode") { optionVar -stringValue MayaSmd_animationLayerMode $parts[1]; }
        else if ($parts[0] == "sourceDeltaMode") { optionVar -stringValue MayaSmd_sourceDeltaMode $parts[1]; }
        else if ($parts[0] == "sourceDeltaUseClip") { optionVar -intValue MayaSmd_sourceDeltaUseClip $parts[1]; }
        else if ($parts[0] == "sourceDeltaClip") { optionVar -stringValue MayaSmd_sourceDeltaClip $parts[1]; }
        else if ($parts[0] == "sourceDeltaReferenceFrame") { optionVar -intValue MayaSmd_sourceDeltaReferenceFrame $parts[1]; }
    }
}
