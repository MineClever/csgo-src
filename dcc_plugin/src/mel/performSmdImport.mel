global proc MayaSmdImport_setOptionVars(int $forceFactorySettings)
{
    if ($forceFactorySettings || !`optionVar -exists MayaSmd_rotateX`) {
        optionVar -floatValue MayaSmd_rotateX 0;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaSmd_rotateY`) {
        optionVar -floatValue MayaSmd_rotateY 0;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaSmd_rotateZ`) {
        optionVar -floatValue MayaSmd_rotateZ 0;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaSmd_useSceneRoot`) {
        optionVar -intValue MayaSmd_useSceneRoot 0;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaSmd_readNamespaceFromScene`) {
        optionVar -intValue MayaSmd_readNamespaceFromScene 1;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaSmd_importMode`) {
        optionVar -stringValue MayaSmd_importMode "create";
    }
}

global proc string MayaSmdImport_defaultOptionsString()
{
    return "rotateX=0;rotateY=0;rotateZ=0;useSceneRoot=0;readNamespaceFromScene=1;importMode=create";
}

global proc string MayaSmdImport_collectOptionVarString()
{
    MayaSmdImport_setOptionVars(0);

    float $rotateX = `optionVar -q MayaSmd_rotateX`;
    float $rotateY = `optionVar -q MayaSmd_rotateY`;
    float $rotateZ = `optionVar -q MayaSmd_rotateZ`;
    int $useSceneRoot = `optionVar -q MayaSmd_useSceneRoot`;
    int $readNamespaceFromScene = `optionVar -q MayaSmd_readNamespaceFromScene`;
    string $importMode = `optionVar -q MayaSmd_importMode`;

    return ("rotateX=" + $rotateX
        + ";rotateY=" + $rotateY
        + ";rotateZ=" + $rotateZ
        + ";useSceneRoot=" + $useSceneRoot
        + ";readNamespaceFromScene=" + $readNamespaceFromScene
        + ";importMode=" + $importMode);
}

global proc MayaSmdImport_applyOptionsString(string $options)
{
    string $effectiveOptions = $options;
    if (size($effectiveOptions) == 0) {
        $effectiveOptions = MayaSmdImport_defaultOptionsString();
    }

    float $rotateX = 0;
    float $rotateY = 0;
    float $rotateZ = 0;
    int $useSceneRoot = 0;
    int $readNamespaceFromScene = 1;
    string $importMode = "create";

    string $optionList[];
    tokenize($effectiveOptions, ";", $optionList);
    for ($option in $optionList) {
        string $parts[];
        tokenize($option, "=", $parts);
        if (size($parts) < 2) {
            continue;
        }

        if ($parts[0] == "rotateX") {
            $rotateX = $parts[1];
        } else if ($parts[0] == "rotateY") {
            $rotateY = $parts[1];
        } else if ($parts[0] == "rotateZ") {
            $rotateZ = $parts[1];
        } else if ($parts[0] == "useSceneRoot") {
            $useSceneRoot = $parts[1];
        } else if ($parts[0] == "readNamespaceFromScene") {
            $readNamespaceFromScene = $parts[1];
        } else if ($parts[0] == "importMode") {
            $importMode = $parts[1];
        }
    }

    if (`floatFieldGrp -exists smdImportEulerRotation`) {
        floatFieldGrp -e -value1 $rotateX -value2 $rotateY -value3 $rotateZ smdImportEulerRotation;
    }
    if (`checkBoxGrp -exists smdImportUseSceneRoot`) {
        checkBoxGrp -e -value1 $useSceneRoot smdImportUseSceneRoot;
    }
    if (`checkBoxGrp -exists smdImportReadNamespaceFromScene`) {
        checkBoxGrp -e -value1 $readNamespaceFromScene smdImportReadNamespaceFromScene;
    }
    if (`optionMenuGrp -exists smdImportMode`) {
        if ($importMode == "update") {
            optionMenuGrp -e -select 2 smdImportMode;
        } else if ($importMode == "append") {
            optionMenuGrp -e -select 3 smdImportMode;
        } else {
            optionMenuGrp -e -select 1 smdImportMode;
        }
    }
}

global proc string MayaSmdImport_collectOptionsString()
{
    float $rotateX = 0;
    float $rotateY = 0;
    float $rotateZ = 0;

    if (`floatFieldGrp -exists smdImportEulerRotation`) {
        $rotateX = `floatFieldGrp -q -value1 smdImportEulerRotation`;
        $rotateY = `floatFieldGrp -q -value2 smdImportEulerRotation`;
        $rotateZ = `floatFieldGrp -q -value3 smdImportEulerRotation`;
    }

    int $useSceneRoot = 0;
    if (`checkBoxGrp -exists smdImportUseSceneRoot`) {
        $useSceneRoot = `checkBoxGrp -q -value1 smdImportUseSceneRoot`;
    }

    int $readNamespaceFromScene = 1;
    if (`checkBoxGrp -exists smdImportReadNamespaceFromScene`) {
        $readNamespaceFromScene = `checkBoxGrp -q -value1 smdImportReadNamespaceFromScene`;
    }

    string $importMode = "create";
    if (`optionMenuGrp -exists smdImportMode`) {
        int $modeSelect = `optionMenuGrp -q -select smdImportMode`;
        if ($modeSelect == 2) {
            $importMode = "update";
        } else if ($modeSelect == 3) {
            $importMode = "append";
        }
    }

    return ("rotateX=" + $rotateX
        + ";rotateY=" + $rotateY
        + ";rotateZ=" + $rotateZ
        + ";useSceneRoot=" + $useSceneRoot
        + ";readNamespaceFromScene=" + $readNamespaceFromScene
        + ";importMode=" + $importMode);
}

global proc string SmdImportOptionsUI(string $parent)
{
    setParent $parent;
    setUITemplate -pushTemplate DefaultTemplate;
    waitCursor -state 1;

    string $optionLayout = `scrollLayout`;
        columnLayout -adjustableColumn true;
            text -align "left" -label "Apply an extra XYZ Euler rotation to the imported SMD root.";
            floatFieldGrp
                -numberOfFields 3
                -label "Root Rotation"
                -annotation "Degrees. Applied as an extra XYZ Euler rotation on the SMD import root."
                smdImportEulerRotation;
            checkBoxGrp
                -numberOfCheckBoxes 1
                -label "Root Target"
                -label1 "Import Directly Into Scene Root"
                -annotation "When enabled, import skips the dedicated wrapper root and places content directly in the Maya scene."
                smdImportUseSceneRoot;
            checkBoxGrp
                -numberOfCheckBoxes 1
                -label "Namespace"
                -label1 "Match Current Maya Namespace"
                -annotation "When enabled, append/update tries to reuse nodes under the current Maya namespace."
                smdImportReadNamespaceFromScene;
            optionMenuGrp
                -label "Merge Mode"
                -annotation "Create creates new nodes. Update reuses matching hierarchy, mesh groups and supported skin data. Append only fills missing nodes."
                smdImportMode;
                menuItem -label "Create New";
                menuItem -label "Update Existing";
                menuItem -label "Append Missing";
        setParent ..;
    setParent ..;

    waitCursor -state 0;
    setUITemplate -popTemplate;
    return $optionLayout;
}

global proc MayaSmd_importFileOptionsUICreate(string $parent)
{
    SmdImportOptionsUI($parent);
}

global proc MayaSmd_importFileOptionsUIInit(string $parent, string $filter)
{
    MayaSmdImport_setOptionVars(0);
    MayaSmdImport_applyOptionsString(MayaSmdImport_collectOptionVarString());
}

global proc MayaSmd_importFileOptionsUICommit(string $parent)
{
    string $optionString = MayaSmdImport_collectOptionsString();
    MayaSmdImport_applyOptionsString($optionString);

    string $optionList[];
    tokenize($optionString, ";", $optionList);
    for ($option in $optionList) {
        string $parts[];
        tokenize($option, "=", $parts);
        if (size($parts) < 2) {
            continue;
        }

        if ($parts[0] == "rotateX") {
            optionVar -floatValue MayaSmd_rotateX $parts[1];
        } else if ($parts[0] == "rotateY") {
            optionVar -floatValue MayaSmd_rotateY $parts[1];
        } else if ($parts[0] == "rotateZ") {
            optionVar -floatValue MayaSmd_rotateZ $parts[1];
        } else if ($parts[0] == "useSceneRoot") {
            optionVar -intValue MayaSmd_useSceneRoot $parts[1];
        } else if ($parts[0] == "readNamespaceFromScene") {
            optionVar -intValue MayaSmd_readNamespaceFromScene $parts[1];
        } else if ($parts[0] == "importMode") {
            optionVar -stringValue MayaSmd_importMode $parts[1];
        }
    }
}
