global proc MayaDmxExport_syncOptionVars(string $version, string $args[])
{
    optionVar -stringValue MayaDmx_exportEncoding $args[1];
    optionVar -stringValue MayaDmx_exportUpAxis $args[2];
    optionVar -intValue MayaDmx_exportSkin $args[3];
    optionVar -intValue MayaDmx_exportDeltaStates $args[4];
    optionVar -intValue MayaDmx_exportMetadata $args[5];
    optionVar -stringValue MayaDmx_exportMaterialRoot $args[6];
    optionVar -floatValue MayaDmx_exportTranslateX $args[7];
    optionVar -floatValue MayaDmx_exportTranslateY $args[8];
    optionVar -floatValue MayaDmx_exportTranslateZ $args[9];
    optionVar -floatValue MayaDmx_exportRotateX $args[10];
    optionVar -floatValue MayaDmx_exportRotateY $args[11];
    optionVar -floatValue MayaDmx_exportRotateZ $args[12];
    optionVar -floatValue MayaDmx_exportScaleX $args[13];
    optionVar -floatValue MayaDmx_exportScaleY $args[14];
    optionVar -floatValue MayaDmx_exportScaleZ $args[15];
}

global proc doDmxExportArgList(string $version, string $args[])
{
    if (!`exists captureDmxExportOptionVars`) {
        eval("source \"performDmxExport.mel\"");
    }

    int $exportAll = $args[0];
    string $optionVarsBackup[] = captureDmxExportOptionVars($version, $exportAll);

    MayaDmxExport_syncOptionVars($version, $args);

    global string $gDmxExportLastDirectory;
    global string $gDmxExportLastWorkspace;

    string $workspaceRoot = `workspace -q -rootDirectory`;
    string $startingDir = $gDmxExportLastDirectory;
    if (size($startingDir) == 0 || $gDmxExportLastWorkspace != $workspaceRoot) {
        $startingDir = $workspaceRoot;
    }

    string $filter = "Valve DMX (*.dmx *.dmxb *.dmxbin);;All Files (*.*)";
    string $result[];
    if ($exportAll) {
        $result = `fileDialog2
            -returnFilter 1
            -fileFilter $filter
            -caption "Export Valve DMX"
            -startingDirectory $startingDir
            -fileMode 0
            -okCaption "Export All"
            -optionsUICreate "MayaDmx_exportFileOptionsUICreate"
            -optionsUIInit "MayaDmx_exportFileOptionsUIInit"
            -optionsUICommit "MayaDmx_exportAllFileOptionsUICommit"
        `;
    } else {
        $result = `fileDialog2
            -returnFilter 1
            -fileFilter $filter
            -caption "Export Valve DMX"
            -startingDirectory $startingDir
            -fileMode 0
            -okCaption "Export Selection"
            -optionsUICreate "MayaDmx_exportFileOptionsUICreate"
            -optionsUIInit "MayaDmx_exportFileOptionsUIInit"
            -optionsUICommit "MayaDmx_exportSelectionFileOptionsUICommit"
        `;
    }

    if (size($result) == 0 || size($result[0]) == 0) {
        MayaDmxExport_syncOptionVars($version, $optionVarsBackup);
        return;
    }

    $gDmxExportLastDirectory = dirname($result[0]);
    $gDmxExportLastWorkspace = $workspaceRoot;

    string $presetName = "__mayaDmxUiExport";
    string $encoding = `optionVar -q MayaDmx_exportEncoding`;
    string $upAxis = `optionVar -q MayaDmx_exportUpAxis`;
    int $exportSkin = `optionVar -q MayaDmx_exportSkin`;
    int $exportDeltaStates = `optionVar -q MayaDmx_exportDeltaStates`;
    int $exportMetadata = `optionVar -q MayaDmx_exportMetadata`;
    string $materialRoot = `optionVar -q MayaDmx_exportMaterialRoot`;
    float $translateX = `optionVar -q MayaDmx_exportTranslateX`;
    float $translateY = `optionVar -q MayaDmx_exportTranslateY`;
    float $translateZ = `optionVar -q MayaDmx_exportTranslateZ`;
    float $rotateX = `optionVar -q MayaDmx_exportRotateX`;
    float $rotateY = `optionVar -q MayaDmx_exportRotateY`;
    float $rotateZ = `optionVar -q MayaDmx_exportRotateZ`;
    float $scaleX = `optionVar -q MayaDmx_exportScaleX`;
    float $scaleY = `optionVar -q MayaDmx_exportScaleY`;
    float $scaleZ = `optionVar -q MayaDmx_exportScaleZ`;

    if (!`exists mayaDmxWorkflow`) {
        error "maya_dmx: mayaDmxWorkflow command is not available.";
        MayaDmxExport_syncOptionVars($version, $optionVarsBackup);
        return;
    }

    mayaDmxWorkflow
        -savePreset $presetName
        -outputDirectory ""
        -materialRoot $materialRoot
        -encoding $encoding
        -upAxis $upAxis
        -translateX $translateX
        -translateY $translateY
        -translateZ $translateZ
        -rotateX $rotateX
        -rotateY $rotateY
        -rotateZ $rotateZ
        -scaleX $scaleX
        -scaleY $scaleY
        -scaleZ $scaleZ
        -exportSkin ($exportSkin == 1)
        -exportDeltaStates ($exportDeltaStates == 1)
        -exportMetadata ($exportMetadata == 1);

    mayaDmxWorkflow
        -exportPreset $presetName
        -filePath $result[0]
        -exportAll ($exportAll == 1);
}
