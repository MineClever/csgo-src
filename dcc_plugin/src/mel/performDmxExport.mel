global proc MayaDmxExport_setOptionVars(int $forceFactorySettings)
{
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportEncoding`) {
        optionVar -stringValue MayaDmx_exportEncoding "text";
    }

    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportUpAxis`) {
        optionVar -stringValue MayaDmx_exportUpAxis "Y";
    }

    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportSkin`) {
        optionVar -intValue MayaDmx_exportSkin 1;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportDeltaStates`) {
        optionVar -intValue MayaDmx_exportDeltaStates 1;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportMetadata`) {
        optionVar -intValue MayaDmx_exportMetadata 1;
    }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_useExportNameOverride`) {
        optionVar -intValue MayaDmx_useExportNameOverride 0;
    }

    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportMaterialRoot`) {
        optionVar -stringValue MayaDmx_exportMaterialRoot "";
    }

    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportTranslateX`) { optionVar -floatValue MayaDmx_exportTranslateX 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportTranslateY`) { optionVar -floatValue MayaDmx_exportTranslateY 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportTranslateZ`) { optionVar -floatValue MayaDmx_exportTranslateZ 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportRotateX`) { optionVar -floatValue MayaDmx_exportRotateX 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportRotateY`) { optionVar -floatValue MayaDmx_exportRotateY 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportRotateZ`) { optionVar -floatValue MayaDmx_exportRotateZ 0; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportScaleX`) { optionVar -floatValue MayaDmx_exportScaleX 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportScaleY`) { optionVar -floatValue MayaDmx_exportScaleY 1; }
    if ($forceFactorySettings || !`optionVar -exists MayaDmx_exportScaleZ`) { optionVar -floatValue MayaDmx_exportScaleZ 1; }
}

global proc string MayaDmxExport_defaultOptionsString()
{
    return "encoding=text;upAxis=Y;exportSkin=1;exportDeltaStates=1;exportMetadata=1;useExportNameOverride=0;materialRoot=;translateX=0;translateY=0;translateZ=0;rotateX=0;rotateY=0;rotateZ=0;scaleX=1;scaleY=1;scaleZ=1";
}

global proc string MayaDmxExport_collectOptionVarString()
{
    MayaDmxExport_setOptionVars(0);
    string $encoding = `optionVar -q MayaDmx_exportEncoding`;
    string $upAxis = `optionVar -q MayaDmx_exportUpAxis`;
    int $exportSkin = `optionVar -q MayaDmx_exportSkin`;
    int $exportDeltaStates = `optionVar -q MayaDmx_exportDeltaStates`;
    int $exportMetadata = `optionVar -q MayaDmx_exportMetadata`;
    int $useExportNameOverride = `optionVar -q MayaDmx_useExportNameOverride`;
    string $materialRoot = `optionVar -q MayaDmx_exportMaterialRoot`;
    float $translateX = `optionVar -q MayaDmx_exportTranslateX`;
    float $translateY = `optionVar -q MayaDmx_exportTranslateY`;
    float $translateZ = `optionVar -q MayaDmx_exportTranslateZ`;
    float $rotateX = `optionVar -q MayaDmx_exportRotateX`;
    float $rotateY = `optionVar -q MayaDmx_exportRotateY`;
    float $rotateZ = `optionVar -q MayaDmx_exportRotateZ`;
    float $scaleX = `optionVar -q MayaDmx_exportScaleX`;
    float $scaleY = `optionVar -q MayaDmx_exportScaleY`;
    float $scaleZ = `optionVar -q MayaDmx_exportScaleZ`;

    return ("encoding=" + $encoding
        + ";upAxis=" + $upAxis
        + ";exportSkin=" + $exportSkin
        + ";exportDeltaStates=" + $exportDeltaStates
        + ";exportMetadata=" + $exportMetadata
        + ";useExportNameOverride=" + $useExportNameOverride
        + ";materialRoot=" + $materialRoot
        + ";translateX=" + $translateX
        + ";translateY=" + $translateY
        + ";translateZ=" + $translateZ
        + ";rotateX=" + $rotateX
        + ";rotateY=" + $rotateY
        + ";rotateZ=" + $rotateZ
        + ";scaleX=" + $scaleX
        + ";scaleY=" + $scaleY
        + ";scaleZ=" + $scaleZ);
}

global proc MayaDmxExport_applyOptionsString(string $options)
{
    string $effectiveOptions = $options;
    if (size($effectiveOptions) == 0) {
        $effectiveOptions = MayaDmxExport_defaultOptionsString();
    }

    string $encoding = "text";
    string $upAxis = "Y";
    int $exportSkin = 1;
    int $exportDeltaStates = 1;
    int $exportMetadata = 1;
    int $useExportNameOverride = 0;
    string $materialRoot = "";
    float $translateX = 0; float $translateY = 0; float $translateZ = 0;
    float $rotateX = 0; float $rotateY = 0; float $rotateZ = 0;
    float $scaleX = 1; float $scaleY = 1; float $scaleZ = 1;

    string $optionList[];
    tokenize($effectiveOptions, ";", $optionList);
    for ($option in $optionList) {
        string $parts[];
        tokenize($option, "=", $parts);
        if (size($parts) < 2) {
            continue;
        }

        string $key = $parts[0];
        string $value = $parts[1];
        if ($key == "encoding") {
            $encoding = $value;
        } else if ($key == "upAxis") {
            $upAxis = $value;
        } else if ($key == "exportSkin") {
            $exportSkin = $value;
        } else if ($key == "exportDeltaStates") {
            $exportDeltaStates = $value;
        } else if ($key == "exportMetadata") {
            $exportMetadata = $value;
        } else if ($key == "useExportNameOverride") {
            $useExportNameOverride = $value;
        } else if ($key == "materialRoot") {
            $materialRoot = $value;
        } else if ($key == "translateX") {
            $translateX = $value;
        } else if ($key == "translateY") {
            $translateY = $value;
        } else if ($key == "translateZ") {
            $translateZ = $value;
        } else if ($key == "rotateX") {
            $rotateX = $value;
        } else if ($key == "rotateY") {
            $rotateY = $value;
        } else if ($key == "rotateZ") {
            $rotateZ = $value;
        } else if ($key == "scaleX") {
            $scaleX = $value;
        } else if ($key == "scaleY") {
            $scaleY = $value;
        } else if ($key == "scaleZ") {
            $scaleZ = $value;
        }
    }

    if (`optionMenuGrp -exists dmxExportEncoding`) {
        optionMenuGrp -e -select (($encoding == "binary") ? 2 : 1) dmxExportEncoding;
    }
    if (`optionMenuGrp -exists dmxExportUpAxis`) {
        optionMenuGrp -e -select (($upAxis == "Z") ? 2 : 1) dmxExportUpAxis;
    }
    if (`checkBoxGrp -exists dmxExportSkin`) {
        checkBoxGrp -e -value1 $exportSkin dmxExportSkin;
    }
    if (`checkBoxGrp -exists dmxExportDeltaStates`) {
        checkBoxGrp -e -value1 $exportDeltaStates dmxExportDeltaStates;
    }
    if (`checkBoxGrp -exists dmxExportMetadata`) {
        checkBoxGrp -e -value1 $exportMetadata dmxExportMetadata;
    }
    if (`checkBoxGrp -exists dmxExportUseExportNameOverride`) {
        checkBoxGrp -e -value1 $useExportNameOverride dmxExportUseExportNameOverride;
    }
    if (`textFieldGrp -exists dmxExportMaterialRoot`) {
        textFieldGrp -e -text $materialRoot dmxExportMaterialRoot;
    }
    if (`floatFieldGrp -exists dmxExportTranslation`) { floatFieldGrp -e -value1 $translateX -value2 $translateY -value3 $translateZ dmxExportTranslation; }
    if (`floatFieldGrp -exists dmxExportRotation`) { floatFieldGrp -e -value1 $rotateX -value2 $rotateY -value3 $rotateZ dmxExportRotation; }
    if (`floatFieldGrp -exists dmxExportScale`) { floatFieldGrp -e -value1 $scaleX -value2 $scaleY -value3 $scaleZ dmxExportScale; }
}

global proc string MayaDmxExport_collectOptionsString()
{
    string $encoding = "text";
    if (`optionMenuGrp -exists dmxExportEncoding` && `optionMenuGrp -q -select dmxExportEncoding` == 2) {
        $encoding = "binary";
    }

    string $upAxis = "Y";
    if (`optionMenuGrp -exists dmxExportUpAxis` && `optionMenuGrp -q -select dmxExportUpAxis` == 2) {
        $upAxis = "Z";
    }

    int $exportSkin = 1;
    if (`checkBoxGrp -exists dmxExportSkin`) {
        $exportSkin = `checkBoxGrp -q -value1 dmxExportSkin`;
    }

    int $exportDeltaStates = 1;
    if (`checkBoxGrp -exists dmxExportDeltaStates`) {
        $exportDeltaStates = `checkBoxGrp -q -value1 dmxExportDeltaStates`;
    }

    int $exportMetadata = 1;
    if (`checkBoxGrp -exists dmxExportMetadata`) {
        $exportMetadata = `checkBoxGrp -q -value1 dmxExportMetadata`;
    }
    int $useExportNameOverride = 0;
    if (`checkBoxGrp -exists dmxExportUseExportNameOverride`) {
        $useExportNameOverride = `checkBoxGrp -q -value1 dmxExportUseExportNameOverride`;
    }

    string $materialRoot = "";
    if (`textFieldGrp -exists dmxExportMaterialRoot`) {
        $materialRoot = `textFieldGrp -q -text dmxExportMaterialRoot`;
    }
    float $translateX = 0; float $translateY = 0; float $translateZ = 0;
    float $rotateX = 0; float $rotateY = 0; float $rotateZ = 0;
    float $scaleX = 1; float $scaleY = 1; float $scaleZ = 1;
    if (`floatFieldGrp -exists dmxExportTranslation`) {
        $translateX = `floatFieldGrp -q -value1 dmxExportTranslation`;
        $translateY = `floatFieldGrp -q -value2 dmxExportTranslation`;
        $translateZ = `floatFieldGrp -q -value3 dmxExportTranslation`;
    }
    if (`floatFieldGrp -exists dmxExportRotation`) {
        $rotateX = `floatFieldGrp -q -value1 dmxExportRotation`;
        $rotateY = `floatFieldGrp -q -value2 dmxExportRotation`;
        $rotateZ = `floatFieldGrp -q -value3 dmxExportRotation`;
    }
    if (`floatFieldGrp -exists dmxExportScale`) {
        $scaleX = `floatFieldGrp -q -value1 dmxExportScale`;
        $scaleY = `floatFieldGrp -q -value2 dmxExportScale`;
        $scaleZ = `floatFieldGrp -q -value3 dmxExportScale`;
    }

    return ("encoding=" + $encoding
        + ";upAxis=" + $upAxis
        + ";exportSkin=" + $exportSkin
        + ";exportDeltaStates=" + $exportDeltaStates
        + ";exportMetadata=" + $exportMetadata
        + ";useExportNameOverride=" + $useExportNameOverride
        + ";materialRoot=" + $materialRoot
        + ";translateX=" + $translateX
        + ";translateY=" + $translateY
        + ";translateZ=" + $translateZ
        + ";rotateX=" + $rotateX
        + ";rotateY=" + $rotateY
        + ";rotateZ=" + $rotateZ
        + ";scaleX=" + $scaleX
        + ";scaleY=" + $scaleY
        + ";scaleZ=" + $scaleZ);
}

global proc MayaDmx_exportSetup(string $parent, int $forceFactorySettings)
{
    MayaDmxExport_setOptionVars($forceFactorySettings);

    setParent $parent;
    MayaDmxExport_applyOptionsString(MayaDmxExport_collectOptionVarString());
}

global proc MayaDmx_exportCallback(string $parent, int $exportAll, int $doIt)
{
    setParent $parent;

    string $optionString = MayaDmxExport_collectOptionsString();
    MayaDmxExport_applyOptionsString($optionString);

    string $optionList[];
    tokenize($optionString, ";", $optionList);
    for ($option in $optionList) {
        string $parts[];
        tokenize($option, "=", $parts);
        if (size($parts) < 2) {
            continue;
        }
        if ($parts[0] == "encoding") {
            optionVar -stringValue MayaDmx_exportEncoding $parts[1];
        } else if ($parts[0] == "upAxis") {
            optionVar -stringValue MayaDmx_exportUpAxis $parts[1];
        } else if ($parts[0] == "exportSkin") {
            optionVar -intValue MayaDmx_exportSkin $parts[1];
        } else if ($parts[0] == "exportDeltaStates") {
            optionVar -intValue MayaDmx_exportDeltaStates $parts[1];
        } else if ($parts[0] == "exportMetadata") {
            optionVar -intValue MayaDmx_exportMetadata $parts[1];
        } else if ($parts[0] == "useExportNameOverride") {
            optionVar -intValue MayaDmx_useExportNameOverride $parts[1];
        } else if ($parts[0] == "materialRoot") {
            optionVar -stringValue MayaDmx_exportMaterialRoot $parts[1];
        } else if ($parts[0] == "translateX") {
            optionVar -floatValue MayaDmx_exportTranslateX $parts[1];
        } else if ($parts[0] == "translateY") {
            optionVar -floatValue MayaDmx_exportTranslateY $parts[1];
        } else if ($parts[0] == "translateZ") {
            optionVar -floatValue MayaDmx_exportTranslateZ $parts[1];
        } else if ($parts[0] == "rotateX") {
            optionVar -floatValue MayaDmx_exportRotateX $parts[1];
        } else if ($parts[0] == "rotateY") {
            optionVar -floatValue MayaDmx_exportRotateY $parts[1];
        } else if ($parts[0] == "rotateZ") {
            optionVar -floatValue MayaDmx_exportRotateZ $parts[1];
        } else if ($parts[0] == "scaleX") {
            optionVar -floatValue MayaDmx_exportScaleX $parts[1];
        } else if ($parts[0] == "scaleY") {
            optionVar -floatValue MayaDmx_exportScaleY $parts[1];
        } else if ($parts[0] == "scaleZ") {
            optionVar -floatValue MayaDmx_exportScaleZ $parts[1];
        }
    }

    if ($doIt) {
        performDmxExport 0 $exportAll;
    }
}

global proc string DmxExportOptionsUI(string $parent)
{
    setParent $parent;
    setUITemplate -pushTemplate DefaultTemplate;
    waitCursor -state 1;

    string $optionLayout = `scrollLayout`;
        columnLayout -adjustableColumn true;
            optionMenuGrp
                -label "Encoding"
                dmxExportEncoding;
                menuItem -label "Text (.dmx)";
                menuItem -label "Binary (.dmxb/.dmxbin)";

            optionMenuGrp
                -label "Up Axis"
                dmxExportUpAxis;
                menuItem -label "Y";
                menuItem -label "Z";

            checkBoxGrp
                -numberOfCheckBoxes 1
                -label "Geometry"
                -label1 "Export Skin"
                dmxExportSkin;

            checkBoxGrp
                -numberOfCheckBoxes 1
                -label "Deformers"
                -label1 "Export Delta States"
                dmxExportDeltaStates;

            checkBoxGrp
                -numberOfCheckBoxes 1
                -label "Metadata"
                -label1 "Export Maya Metadata"
                dmxExportMetadata;

            checkBoxGrp
                -numberOfCheckBoxes 1
                -label "Names"
                -label1 "Use sourceExportName Attribute"
                -annotation "When enabled, the exporter uses each node's sourceExportName string attribute as the written node name when present."
                dmxExportUseExportNameOverride;

            textFieldGrp
                -label "Material Root"
                dmxExportMaterialRoot;
        setParent ..;
    setParent ..;

    waitCursor -state 0;
    setUITemplate -popTemplate;
    return $optionLayout;
}

global proc DmxExportOptions(int $exportAll)
{
    string $commandName;
    string $label;
    if ($exportAll) {
        $commandName = "DmxExportAll";
        $label = "Export All";
    } else {
        $commandName = "DmxExportSelection";
        $label = "Export Selection";
    }

    string $callback = "MayaDmx_exportCallback";
    string $setup = "MayaDmx_exportSetup";
    string $layout = getOptionBox();
    setOptionBoxCommandName($commandName);

    string $parent = DmxExportOptionsUI($layout);

    string $exportBtn = getOptionBoxApplyBtn();
    button -e -label $label -command ($callback + " " + $parent + " " + $exportAll + " 1") $exportBtn;

    string $saveBtn = getOptionBoxSaveBtn();
    button -e -command ($callback + " " + $parent + " " + $exportAll + " 0; hideOptionBox") $saveBtn;

    string $resetBtn = getOptionBoxResetBtn();
    button -e -command ($setup + " " + $parent + " 1") $resetBtn;

    setOptionBoxTitle("Source DMX Export");
    setOptionBoxHelpTag($commandName);
    eval($setup + " " + $parent + " 0");
    showOptionBox();
}

global proc string[] captureDmxExportOptionVars(int $version, int $exportAll)
{
    MayaDmxExport_setOptionVars(0);
    int $exportSkin = `optionVar -q MayaDmx_exportSkin`;
    int $exportDeltaStates = `optionVar -q MayaDmx_exportDeltaStates`;
    int $exportMetadata = `optionVar -q MayaDmx_exportMetadata`;

    string $exportAllString = $exportAll;
    string $exportSkinString = $exportSkin;
    string $exportDeltaStatesString = $exportDeltaStates;
    string $exportMetadataString = $exportMetadata;

    string $args[];
    $args[0] = $exportAllString;
    $args[1] = `optionVar -q MayaDmx_exportEncoding`;
    $args[2] = `optionVar -q MayaDmx_exportUpAxis`;
    $args[3] = $exportSkinString;
    $args[4] = $exportDeltaStatesString;
    $args[5] = $exportMetadataString;
    $args[6] = `optionVar -q MayaDmx_exportMaterialRoot`;
    $args[7] = `optionVar -q MayaDmx_exportTranslateX`;
    $args[8] = `optionVar -q MayaDmx_exportTranslateY`;
    $args[9] = `optionVar -q MayaDmx_exportTranslateZ`;
    $args[10] = `optionVar -q MayaDmx_exportRotateX`;
    $args[11] = `optionVar -q MayaDmx_exportRotateY`;
    $args[12] = `optionVar -q MayaDmx_exportRotateZ`;
    $args[13] = `optionVar -q MayaDmx_exportScaleX`;
    $args[14] = `optionVar -q MayaDmx_exportScaleY`;
    $args[15] = `optionVar -q MayaDmx_exportScaleZ`;

    return $args;
}

global proc string assembleDmxExportCmd(int $exportAll)
{
    int $version = 1;
    string $args[] = captureDmxExportOptionVars($version, $exportAll);
    string $cmd = "doDmxExportArgList " + $version + " {";
    int $i;
    for ($i = 0; $i < size($args); ++$i) {
        if ($i > 0) {
            $cmd += ",";
        }
        $cmd += ("\"" + encodeString($args[$i]) + "\"");
    }
    $cmd += "};";
    return $cmd;
}

global proc MayaDmx_exportFileOptionsUICreate(string $parent)
{
    DmxExportOptionsUI($parent);
}

global proc MayaDmx_exportFileOptionsUIInit(string $parent, string $filter)
{
    MayaDmx_exportSetup($parent, 0);
}

global proc MayaDmx_exportAllFileOptionsUICommit(string $parent)
{
    MayaDmx_exportCallback($parent, 1, 0);
}

global proc MayaDmx_exportSelectionFileOptionsUICommit(string $parent)
{
    MayaDmx_exportCallback($parent, 0, 0);
}

global proc string performDmxExport(int $action, int $exportAll)
{
    string $cmd = "";

    switch ($action) {
    case 0:
        $cmd = assembleDmxExportCmd($exportAll);
        eval($cmd);
        break;
    case 1:
        DmxExportOptions($exportAll);
        break;
    case 2:
        $cmd = assembleDmxExportCmd($exportAll);
        break;
    }

    return $cmd;
}
