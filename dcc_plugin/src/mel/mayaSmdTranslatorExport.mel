global proc string SmdExportOptionsUI(string $parent)
{
    setParent $parent;
    string $layout = `columnLayout -adjustableColumn true mayaSmdTranslatorExportOptions`;

    text
        -align "left"
        -label "Choose whether the export should include mesh triangles, animation skeleton keys, or both."
        -annotation "These options control which parts of the SMD file are written. Mesh exports write triangles and normals. Animation exports write the skeleton section."
        smdExportModeHint;

    checkBoxGrp
        -numberOfCheckBoxes 1
        -label "Export Mesh"
        -annotation "When enabled, the exporter writes triangle geometry, normals, UVs and skin weights to the SMD file."
        smdExportMesh;

    checkBoxGrp
        -numberOfCheckBoxes 1
        -label "Export Animation"
        -annotation "When enabled, the exporter writes skeleton frames and bone transforms to the SMD file."
        smdExportAnimation;

    checkBoxGrp
        -numberOfCheckBoxes 1
        -label "UV"
        -label1 "Flip UV V (1 - V)"
        -annotation "Matches the legacy SMD import/export convention by flipping the V coordinate before writing UVs."
        smdExportFlipUvV;

    checkBoxGrp
        -numberOfCheckBoxes 1
        -label "Names"
        -label1 "Use sourceExportName Attribute"
        -annotation "When enabled, the exporter uses each node's sourceExportName string attribute as the written node name when present."
        smdExportUseExportNameOverride;

    floatFieldGrp
        -numberOfFields 3
        -label "Translation"
        -annotation "Applies export-space translation correction. This changes the written coordinate space, not the scene itself."
        smdExportTranslation;

    floatFieldGrp
        -numberOfFields 3
        -label "Rotation"
        -annotation "Applies export-space rotation correction in degrees. Use this to match the target tool or engine axis convention."
        smdExportRotation;

    floatFieldGrp
        -numberOfFields 3
        -label "Scale"
        -annotation "Applies export-space scale correction. This affects written mesh data and skeleton translations."
        smdExportScale;

    return $layout;
}

global proc int mayaSmdTranslatorExport(string $parent,
                                        string $action,
                                        string $initialSettings,
                                        string $resultCallback)
{
    if (!`exists MayaSmdExport_applyOptionsString`) {
        source "performSmdExport.mel";
    }

    if ($action == "post") {
        SmdExportOptionsUI($parent);
        MayaSmdExport_applyOptionsString($initialSettings);
        return 1;
    }

    if ($action == "fill") {
        MayaSmdExport_applyOptionsString($initialSettings);
        return 1;
    }

    if ($action == "query") {
        string $optionsString = MayaSmdExport_collectOptionsString();
        eval($resultCallback + " \"" + $optionsString + "\"");
        return 1;
    }

    return 0;
}
