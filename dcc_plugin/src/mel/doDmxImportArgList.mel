global proc MayaDmxImport_syncOptionVars(string $version, string $args[])
{
    optionVar -intValue MayaDmx_importMaterials $args[0];
    optionVar -intValue MayaDmx_importSkin $args[1];
    optionVar -intValue MayaDmx_importDeltaStates $args[2];
    if (size($args) > 3) { optionVar -intValue MayaDmx_useSceneRoot $args[3]; }
    if (size($args) > 4) { optionVar -stringValue MayaDmx_importMode $args[4]; }
    if (size($args) > 5) { optionVar -floatValue MayaDmx_translateX $args[5]; }
    if (size($args) > 6) { optionVar -floatValue MayaDmx_translateY $args[6]; }
    if (size($args) > 7) { optionVar -floatValue MayaDmx_translateZ $args[7]; }
    if (size($args) > 8) { optionVar -floatValue MayaDmx_rotateX $args[8]; }
    if (size($args) > 9) { optionVar -floatValue MayaDmx_rotateY $args[9]; }
    if (size($args) > 10) { optionVar -floatValue MayaDmx_rotateZ $args[10]; }
    if (size($args) > 11) { optionVar -floatValue MayaDmx_scaleX $args[11]; }
    if (size($args) > 12) { optionVar -floatValue MayaDmx_scaleY $args[12]; }
    if (size($args) > 13) { optionVar -floatValue MayaDmx_scaleZ $args[13]; }
    if (size($args) > 14) { optionVar -intValue MayaDmx_importAnimationToLayer $args[14]; }
    if (size($args) > 15) { optionVar -stringValue MayaDmx_animationLayerMode $args[15]; }
    if (size($args) > 16) { optionVar -stringValue MayaDmx_sourceDeltaMode $args[16]; }
    if (size($args) > 17) { optionVar -intValue MayaDmx_sourceDeltaUseClip $args[17]; }
    if (size($args) > 18) { optionVar -stringValue MayaDmx_sourceDeltaClip $args[18]; }
    if (size($args) > 19) { optionVar -intValue MayaDmx_sourceDeltaReferenceFrame $args[19]; }
}

global proc doDmxImportArgList(string $version, string $args[])
{
    if (!`exists captureDmxImportOptionVars`) {
        eval("source \"performDmxImport.mel\"");
    }

    string $optionVarsBackup[] = captureDmxImportOptionVars($version);
    MayaDmxImport_syncOptionVars($version, $args);

    global string $gDmxImportLastDirectory;
    global string $gDmxImportLastWorkspace;

    string $workspaceRoot = `workspace -q -rootDirectory`;
    string $startingDir = $gDmxImportLastDirectory;
    if (size($startingDir) == 0 || $gDmxImportLastWorkspace != $workspaceRoot) {
        $startingDir = $workspaceRoot;
    }

    string $filter = "Valve DMX (*.dmx *.dmxb *.dmxbin);;All Files (*.*)";
    string $result[] = `fileDialog2
        -returnFilter 1
        -fileFilter $filter
        -caption "Import Valve DMX"
        -startingDirectory $startingDir
        -fileMode 1
        -okCaption "Import"
        -optionsUICreate "MayaDmx_importFileOptionsUICreate"
        -optionsUIInit "MayaDmx_importFileOptionsUIInit"
        -optionsUICommit "MayaDmx_importFileOptionsUICommit"
    `;

    if (size($result) == 0 || size($result[0]) == 0) {
        MayaDmxImport_syncOptionVars($version, $optionVarsBackup);
        return;
    }

    $gDmxImportLastDirectory = dirname($result[0]);
    $gDmxImportLastWorkspace = $workspaceRoot;

    string $options = ("importMaterials=" + `optionVar -q MayaDmx_importMaterials`
        + ";importSkin=" + `optionVar -q MayaDmx_importSkin`
        + ";importDeltaStates=" + `optionVar -q MayaDmx_importDeltaStates`
        + ";useSceneRoot=" + `optionVar -q MayaDmx_useSceneRoot`
        + ";importMode=" + `optionVar -q MayaDmx_importMode`
        + ";translateX=" + `optionVar -q MayaDmx_translateX`
        + ";translateY=" + `optionVar -q MayaDmx_translateY`
        + ";translateZ=" + `optionVar -q MayaDmx_translateZ`
        + ";rotateX=" + `optionVar -q MayaDmx_rotateX`
        + ";rotateY=" + `optionVar -q MayaDmx_rotateY`
        + ";rotateZ=" + `optionVar -q MayaDmx_rotateZ`
        + ";scaleX=" + `optionVar -q MayaDmx_scaleX`
        + ";scaleY=" + `optionVar -q MayaDmx_scaleY`
        + ";scaleZ=" + `optionVar -q MayaDmx_scaleZ`
        + ";importAnimationToLayer=" + `optionVar -q MayaDmx_importAnimationToLayer`
        + ";animationLayerMode=" + `optionVar -q MayaDmx_animationLayerMode`
        + ";sourceDeltaMode=" + `optionVar -q MayaDmx_sourceDeltaMode`
        + ";sourceDeltaUseClip=" + `optionVar -q MayaDmx_sourceDeltaUseClip`
        + ";sourceDeltaReferenceFrame=" + `optionVar -q MayaDmx_sourceDeltaReferenceFrame`);
    string $sceneClip = `optionVar -q MayaDmx_sourceDeltaClip`;
    if (size($sceneClip) > 0) { $options += (";sourceDeltaClip=" + $sceneClip); }

    file
        -import
        -type "Valve DMX Import"
        -ignoreVersion
        -ra true
        -options $options
        $result[0];
}
